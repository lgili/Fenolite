# Every text file has LF line ends in a checkout, on Windows too: fixtures, golden files and hashes
# compare bytes (change c0025).
* text=auto eol=lf
# Test data is compared byte for byte, its own line ends included.
tests/data/** -text
# The authored PDF's fixed-width xref padding is part of its binary structure.
tests/data/proposals/*.pdf binary
*.Harness -text

# Altium files keep their exact bytes: CR LF line ends are part of what is checked (change c0032).
*.SchDoc -text
*.PrjPcb -text
*.SchLib -text
*.PcbLib -text
*.PcbDoc -text
# Text companions of an Altium project (change c0042): kept byte for byte as well.
*.OutJob -text
*.RUL -text
*.stackup -text
