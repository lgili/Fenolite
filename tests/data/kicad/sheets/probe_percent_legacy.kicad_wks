(page_layout
	(setup
		(textsize 1.5 1.5)
		(linewidth 0.15)
		(textlinewidth 0.15)
		(left_margin 10)
		(right_margin 10)
		(top_margin 10)
		(bottom_margin 10)
	)
	(tbtext "Percent"
		(name "")
		(pos 20 20 ltcorner)
	)
	(tbtext "Title: %T"
		(name "")
		(pos 20 30 ltcorner)
	)
	(tbtext "Rev: %R"
		(name "")
		(pos 20 40 ltcorner)
	)
)
