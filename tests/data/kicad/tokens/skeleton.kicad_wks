(kicad_wks
	(version 20231118)
	(generator "fenolite")
	(setup
		(textsize 1.5 1.5)
		(linewidth 0.15)
		(textlinewidth 0.15)
		(left_margin 10)
		(right_margin 10)
		(top_margin 10)
		(bottom_margin 10)
	)
	(rect
		(name "frame")
		(start 0 0 ltcorner)
		(end 0 0)
		(repeat 2)
		(incrx 2)
		(incry 2)
	)
	(line
		(name "")
		(start 50 2 ltcorner)
		(end 50 0 ltcorner)
		(repeat 30)
		(incrx 50)
	)
	(tbtext "1"
		(name "")
		(pos 25 1 ltcorner)
		(font
			(size 1.3 1.3)
		)
		(repeat 100)
		(incrx 50)
		(incrlabel 1)
	)
	(tbtext "${TITLE}"
		(name "")
		(pos 100 10)
		(font bold italic
			(size 2 2)
		)
		(justify left)
		(rotate 0)
		(maxlen 80)
		(maxheight 5)
		(comment "title")
		(option page1only)
	)
)
