(version 1)
(rule "fenolite_0_min_clearance"
	(constraint clearance (min 0.15mm))
	(severity error)
)
(rule "fenolite_0_min_edge_clearance"
	(constraint edge_clearance (min 0.3mm))
	(severity error)
)
(rule "fenolite_0_min_hole_size"
	(constraint hole_size (min 0.3mm))
	(severity error)
)
(rule "fenolite_0_min_track_width"
	(constraint track_width (min 0.15mm))
	(severity error)
)
(rule "fenolite_0_min_via_diameter"
	(constraint via_diameter (min 0.45mm))
	(severity error)
)
(rule "fenolite_0_min_via_drill"
	(condition "A.Type == 'Via'")
	(constraint hole_size (min 0.2mm))
	(severity error)
)
(rule "fenolite_1_min_clearance_pwr"
	(condition "A.NetClass == 'PWR'")
	(constraint clearance (min 0.2mm))
	(severity error)
)
(rule "fenolite_1_min_track_width_pwr"
	(condition "A.NetClass == 'PWR'")
	(constraint track_width (min 0.4mm))
	(severity error)
)
