{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fenolite.result.impedance.v0",
  "title": "ImpedanceResult",
  "type": "object",
  "properties": {
    "plan": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProtocolPlan"
      }
    },
    "plan_id": {
      "type": "string"
    },
    "issues_summary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProtocolIssueSummary"
      }
    },
    "recovery": {
      "$ref": "#/$defs/ProtocolRecovery"
    },
    "page": {
      "$ref": "#/$defs/ProtocolPage"
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "counts": {
      "$ref": "#/$defs/ImpedanceCounts"
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ImpedanceRowsItem"
      }
    },
    "source": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "ImpedanceCounts": {
      "type": "object",
      "properties": {
        "estimated": {
          "type": "integer"
        },
        "left_out": {
          "type": "integer"
        },
        "rows": {
          "type": "integer"
        },
        "targets": {
          "type": "integer"
        }
      },
      "additionalProperties": true,
      "required": [
        "estimated",
        "left_out",
        "rows",
        "targets"
      ]
    },
    "ImpedanceRowsItem": {
      "type": "object",
      "properties": {
        "classes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "epsilon_r": {
          "type": "string"
        },
        "estimate": {
          "$ref": "#/$defs/ImpedanceRowsItemEstimate"
        },
        "gap": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "heights": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "type": "string"
        },
        "layer": {
          "type": "string"
        },
        "nets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ohms": {
          "type": "string"
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "structure": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "tolerance_percent": {
          "type": "string"
        },
        "width": {
          "type": "integer"
        }
      },
      "additionalProperties": true,
      "required": [
        "classes",
        "epsilon_r",
        "gap",
        "heights",
        "kind",
        "layer",
        "nets",
        "ohms",
        "references",
        "structure",
        "target",
        "tolerance_percent",
        "width"
      ]
    },
    "ImpedanceRowsItemEstimate": {
      "type": "object",
      "properties": {
        "form": {
          "type": "string"
        },
        "in_range": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "mohm": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string"
        },
        "suggested_width": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true,
      "required": [
        "form",
        "in_range",
        "mohm",
        "reason",
        "suggested_width"
      ]
    },
    "ProtocolIssueSummary": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "count": {
          "type": "integer"
        },
        "by_severity": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "x-fenolite-map": true,
          "description": "counts indexed by severity"
        }
      },
      "additionalProperties": true,
      "required": [
        "code",
        "count",
        "by_severity"
      ]
    },
    "ProtocolPage": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "limit": {
          "type": "integer"
        },
        "offset": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        },
        "next": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true,
      "required": [
        "path",
        "limit",
        "offset",
        "total",
        "next"
      ]
    },
    "ProtocolPlan": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "bytes": {
          "type": "integer"
        },
        "sha256": {
          "type": "string"
        },
        "overwrite": {
          "type": "boolean"
        }
      },
      "additionalProperties": true,
      "required": [
        "path",
        "kind",
        "bytes",
        "sha256",
        "overwrite"
      ]
    },
    "ProtocolRecovery": {
      "type": "object",
      "properties": {
        "failed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preserved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "failed",
        "preserved"
      ]
    }
  }
}
