{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fenolite.result.copper.v0",
  "title": "CopperResult",
  "type": "object",
  "properties": {
    "plan": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProtocolPlan"
      }
    },
    "plan_id": {
      "type": "string"
    },
    "issues_summary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProtocolIssueSummary"
      }
    },
    "recovery": {
      "$ref": "#/$defs/ProtocolRecovery"
    },
    "page": {
      "$ref": "#/$defs/ProtocolPage"
    },
    "after": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RoleFinding"
      }
    },
    "before": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CopperBeforeItem"
      }
    },
    "board": {
      "type": "string"
    },
    "changed": {
      "type": "boolean"
    },
    "cleared": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CopperClearedItem"
      }
    },
    "corridors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CopperCorridorsItem"
      }
    },
    "gate": {
      "anyOf": [
        {
          "$ref": "#/$defs/GateSummary"
        },
        {
          "type": "null"
        }
      ]
    },
    "kept": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CopperNetsItem"
      }
    },
    "next": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "records": {
      "type": "integer"
    },
    "replaced": {
      "type": "integer"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "vias": {
      "type": "integer"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "CopperBeforeItem": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "where": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "code",
        "severity",
        "where"
      ]
    },
    "CopperClearedItem": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "where": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "code",
        "severity",
        "where"
      ]
    },
    "CopperCorridorsItem": {
      "type": "object",
      "properties": {
        "group": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "layer": {
          "type": "string"
        },
        "net": {
          "type": "string"
        },
        "origin": {
          "type": "string"
        },
        "polygons": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          }
        },
        "width": {
          "type": "integer"
        }
      },
      "additionalProperties": true,
      "required": [
        "group",
        "key",
        "kind",
        "layer",
        "net",
        "origin",
        "polygons",
        "width"
      ]
    },
    "CopperNetsItem": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "layers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_width": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "method": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "net": {
          "type": "string"
        },
        "skipped": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "vias": {
          "type": "integer"
        },
        "width": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "zones": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "kind",
        "layers",
        "max_width",
        "method",
        "net",
        "skipped",
        "vias",
        "width",
        "zones"
      ]
    },
    "GateDropped": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GateFinding"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "id",
        "findings"
      ]
    },
    "GateFinding": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "uuids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "type",
        "severity",
        "description",
        "uuids",
        "items"
      ]
    },
    "GateSummary": {
      "type": "object",
      "properties": {
        "tool_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "runs": {
          "type": "integer"
        },
        "refilled": {
          "type": "boolean"
        },
        "items": {
          "type": "integer"
        },
        "kept": {
          "type": "integer"
        },
        "dropped": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GateDropped"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GateFinding"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "tool_version",
        "runs",
        "refilled",
        "items",
        "kept",
        "dropped",
        "findings"
      ]
    },
    "ProtocolIssueSummary": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "count": {
          "type": "integer"
        },
        "by_severity": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "x-fenolite-map": true,
          "description": "counts indexed by severity"
        }
      },
      "additionalProperties": true,
      "required": [
        "code",
        "count",
        "by_severity"
      ]
    },
    "ProtocolPage": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "limit": {
          "type": "integer"
        },
        "offset": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        },
        "next": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true,
      "required": [
        "path",
        "limit",
        "offset",
        "total",
        "next"
      ]
    },
    "ProtocolPlan": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "bytes": {
          "type": "integer"
        },
        "sha256": {
          "type": "string"
        },
        "overwrite": {
          "type": "boolean"
        }
      },
      "additionalProperties": true,
      "required": [
        "path",
        "kind",
        "bytes",
        "sha256",
        "overwrite"
      ]
    },
    "ProtocolRecovery": {
      "type": "object",
      "properties": {
        "failed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preserved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "failed",
        "preserved"
      ]
    },
    "RoleFinding": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "where": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "code",
        "severity",
        "where"
      ]
    }
  }
}
