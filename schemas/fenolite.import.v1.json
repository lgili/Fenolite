{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fenolite.result.import.v1",
  "title": "ImportResult",
  "type": "object",
  "properties": {
    "plan": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProtocolPlan"
      }
    },
    "plan_id": {
      "type": "string"
    },
    "issues_summary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProtocolIssueSummary"
      }
    },
    "recovery": {
      "$ref": "#/$defs/ProtocolRecovery"
    },
    "page": {
      "$ref": "#/$defs/ProtocolPage"
    },
    "adopted": {
      "anyOf": [
        {
          "$ref": "#/$defs/AdoptedSummary"
        },
        {
          "type": "null"
        }
      ]
    },
    "counts": {
      "$ref": "#/$defs/ImportCounts"
    },
    "design": {
      "type": "string"
    },
    "equivalence": {
      "$ref": "#/$defs/ImportEquivalence"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ImportFilesItem"
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "out": {
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/ImportProvenance"
    },
    "source": {
      "$ref": "#/$defs/ImportSource"
    },
    "unexpressed": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ImportUnexpressed"
      }
    },
    "upgrade": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ImportUpgrade"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "AdoptedSummary": {
      "type": "object",
      "properties": {
        "board": {
          "type": "string"
        },
        "rewritten": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "x-fenolite-map": true,
          "description": "rewritten UUID counts by native item kind"
        },
        "paths": {
          "type": "integer"
        },
        "unmatched": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "x-fenolite-map": true,
          "description": "unmatched source counts by native item kind"
        }
      },
      "additionalProperties": true,
      "required": [
        "board",
        "rewritten",
        "paths",
        "unmatched"
      ]
    },
    "ImportCounts": {
      "type": "object",
      "properties": {
        "arcs": {
          "type": "integer"
        },
        "drawings": {
          "type": "integer"
        },
        "nets": {
          "type": "integer"
        },
        "parts": {
          "type": "integer"
        },
        "rule_areas": {
          "type": "integer"
        },
        "tables": {
          "type": "integer"
        },
        "tracks": {
          "type": "integer"
        },
        "vias": {
          "type": "integer"
        },
        "zones": {
          "type": "integer"
        }
      },
      "additionalProperties": true,
      "required": [
        "arcs",
        "drawings",
        "nets",
        "parts",
        "rule_areas",
        "tables",
        "tracks",
        "vias",
        "zones"
      ]
    },
    "ImportEquivalence": {
      "type": "object",
      "properties": {
        "equivalent": {
          "type": "boolean"
        },
        "levels": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "equivalent",
        "levels"
      ]
    },
    "ImportFilesItem": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "bytes",
        "path"
      ]
    },
    "ImportProvenance": {
      "type": "object",
      "properties": {
        "licence": {
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true,
      "required": [
        "licence",
        "revision",
        "source"
      ]
    },
    "ImportSource": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "versions": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "x-fenolite-map": true
        }
      },
      "additionalProperties": true,
      "required": [
        "backend",
        "file",
        "versions"
      ]
    },
    "ImportUnexpressed": {
      "description": "One kind of item no DSL call expresses, its count and up to three examples.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "kind",
        "count",
        "examples"
      ]
    },
    "ImportUpgrade": {
      "description": "One file upgraded by ``kicad-cli`` on a private copy.",
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "tool_version": {
          "type": "string"
        },
        "from_version": {
          "type": "integer"
        },
        "to_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256_before": {
          "type": "string"
        },
        "sha256_after": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "file",
        "tool",
        "tool_version",
        "from_version",
        "to_version",
        "sha256_before",
        "sha256_after"
      ]
    },
    "ProtocolIssueSummary": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "count": {
          "type": "integer"
        },
        "by_severity": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "x-fenolite-map": true,
          "description": "counts indexed by severity"
        }
      },
      "additionalProperties": true,
      "required": [
        "code",
        "count",
        "by_severity"
      ]
    },
    "ProtocolPage": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "limit": {
          "type": "integer"
        },
        "offset": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        },
        "next": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true,
      "required": [
        "path",
        "limit",
        "offset",
        "total",
        "next"
      ]
    },
    "ProtocolPlan": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "bytes": {
          "type": "integer"
        },
        "sha256": {
          "type": "string"
        },
        "overwrite": {
          "type": "boolean"
        }
      },
      "additionalProperties": true,
      "required": [
        "path",
        "kind",
        "bytes",
        "sha256",
        "overwrite"
      ]
    },
    "ProtocolRecovery": {
      "type": "object",
      "properties": {
        "failed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preserved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "failed",
        "preserved"
      ]
    }
  }
}
