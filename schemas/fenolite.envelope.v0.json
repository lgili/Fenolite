{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fenolite.envelope.v0",
  "title": "Envelope",
  "description": "The single JSON document every ``fenolite`` command prints on stdout.",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "command": {
      "type": "string"
    },
    "schema": {
      "type": "string",
      "pattern": "^fenolite\\.[a-z_][a-z0-9_-]*\\.v0$"
    },
    "input": {
      "anyOf": [
        {
          "$ref": "#/$defs/InputRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "result": {
      "type": "object"
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Issue"
      }
    },
    "evidence": {
      "$ref": "#/$defs/Evidence"
    },
    "receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/Receipt"
        },
        {
          "type": "null"
        }
      ]
    },
    "elapsed_ms": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "ok",
    "command",
    "schema",
    "input",
    "result",
    "issues",
    "evidence",
    "receipt",
    "elapsed_ms"
  ],
  "$defs": {
    "Evidence": {
      "description": "A level plus the oracle that produced it and the hypotheses it depends on.",
      "type": "object",
      "properties": {
        "level": {
          "enum": [
            "ALTIUM-VERIFIED(kit)",
            "KICAD-VERIFIED",
            "ORACLE-VERIFIED",
            "CORPUS-VERIFIED",
            "ALTIUM-VERIFIED(author-report)",
            "INFERRED",
            "UNKNOWN",
            "UNVERIFIED"
          ]
        },
        "oracle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "hypotheses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "level",
        "oracle",
        "hypotheses"
      ]
    },
    "InputRef": {
      "description": "The design file a command read.",
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "type": "string"
        },
        "format_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "kind",
        "format_version"
      ]
    },
    "Issue": {
      "description": "A finding reported by a command. Findings of severity ``error`` make the exit code 5.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9-]+)+$"
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "message": {
          "type": "string"
        },
        "where": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "message",
        "where",
        "hint",
        "retryable"
      ]
    },
    "Receipt": {
      "description": "Files written by a confirmed mutating command, and the backups kept.",
      "type": "object",
      "properties": {
        "written": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WrittenFile"
          }
        },
        "backup": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "id": {
          "type": "string",
          "pattern": "^([0-9a-f]{16})?$"
        },
        "undo": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "written",
        "backup"
      ]
    },
    "WrittenFile": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ]
    }
  }
}
