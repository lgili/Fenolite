      "properties": {
        "subject": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "router": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "subject",
        "reason",
        "router",
        "details"
      ]
    },
    "ProposalFacts": {
      "type": "object",
      "properties": {
        "vias": {
          "type": "integer"
        },
        "length": {
          "type": "integer"
        },
        "layers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bends": {
          "type": "integer"
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fill": {
          "type": "string"
        },
        "current": {
          "type": "string"
