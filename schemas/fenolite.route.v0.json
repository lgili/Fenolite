        "copper_check": {
          "$ref": "#/$defs/ProposalCopper"
        },
        "roles": {
          "$ref": "#/$defs/ProposalRoles"
        },
        "loop": {
          "$ref": "#/$defs/ProposalLoop"
        },
        "drc": {
          "$ref": "#/$defs/ProposalDrc"
        },
        "not_evaluated": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProposalNotEvaluated"
          }
        },
        "role_fields": {
          "$ref": "#/$defs/ProposalCandidateRoleFields"
        }
