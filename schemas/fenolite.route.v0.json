  "additionalProperties": true,
  "$defs": {
    "GateDropped": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GateFinding"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "id",
        "findings"
      ]
    },
    "GateFinding": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "uuids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "type",
        "severity",
        "description",
        "uuids",
        "items"
      ]
    },
    "GateSummary": {
      "type": "object",
      "properties": {
        "tool_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "runs": {
          "type": "integer"
        },
        "refilled": {
          "type": "boolean"
        },
        "items": {
          "type": "integer"
        },
        "kept": {
          "type": "integer"
        },
        "dropped": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GateDropped"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GateFinding"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "tool_version",
        "runs",
        "refilled",
        "items",
        "kept",
        "dropped",
        "findings"
      ]
    },
    "Proposal": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "net": {
          "type": "string"
        },
        "ends": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProposalEnd"
          }
        },
        "region": {
          "type": "string"
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProposalCandidate"
          }
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "alternatives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProposalAlternative"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "id",
        "subject",
        "kind",
        "net",
        "ends",
        "region",
        "candidates",
        "reason",
        "alternatives"
      ]
    },
    "ProposalAccepted": {
      "type": "object",
      "properties": {
        "candidate": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "facts": {
          "$ref": "#/$defs/ProposalFacts"
        },
        "source": {
          "type": "string"
        },
        "tool": {
          "$ref": "#/$defs/ProposalTool"
        }
      },
      "additionalProperties": true,
      "required": [
        "candidate",
        "subject",
        "facts"
      ]
    },
    "ProposalAlternative": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "then": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "kind",
        "text",
        "command",
        "region"
      ]
    },
    "ProposalBundle": {
      "description": "c0367: one negotiated atomic unit; member geometry stays in the candidate rows.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "id",
        "fingerprint",
        "members",
        "subjects"
      ]
    },
    "ProposalCandidate": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "relaxed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "items": {
          "$ref": "#/$defs/ProposalItems"
        },
        "geometry": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/ProposalTrack"
              },
              {
                "$ref": "#/$defs/ProposalVia"
              }
            ]
          }
        },
        "facts": {
          "$ref": "#/$defs/ProposalFacts"
        },
        "rejected": {
          "type": "boolean"
        },
        "bundle": {
          "type": "string"
        },
        "tool": {
          "$ref": "#/$defs/ProposalTool"
        }
      },
      "additionalProperties": true,
      "required": [
        "id",
        "source",
        "relaxed",
        "items",
        "geometry",
        "facts",
        "rejected"
      ]
    },
    "ProposalCandidateRoleFields": {
      "description": "c0366: the fields after a candidate and its conservative reference and exposure bounds.",
      "type": "object",
      "properties": {
        "fingerprint": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/ProposalFieldProvenance"
        },
        "limits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProposalRoleLimit"
          }
        },
        "preferences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProposalRolePreference"
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_limits": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "input_fingerprint": {
          "type": "string"
        },
        "input_provenance": {
          "$ref": "#/$defs/ProposalFieldProvenance"
        },
        "confirmed_reference_length_lower_bound_nm": {
          "type": "integer"
        },
        "unconfirmed_reference_length_nm": {
          "type": "integer"
        },
        "switching_exposure_upper_bound_nm": {
          "type": "integer"
        }
      },
      "additionalProperties": true,
      "required": [
        "fingerprint",
        "provenance",
        "limits",
        "preferences",
        "unknowns",
        "missing_limits",
        "input_fingerprint",
        "input_provenance",
        "confirmed_reference_length_lower_bound_nm",
        "unconfirmed_reference_length_nm",
        "switching_exposure_upper_bound_nm"
      ]
    },
    "ProposalCompletion": {
      "description": "c0370: the physical open count and every subject's state; never a completion claim.",
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "open",
            "unchecked"
          ]
        },
        "open": {
          "type": "integer"
        },
        "fill": {
          "enum": [
            "saved",
            "simulated"
          ]
        },
        "subjects": {
          "$ref": "#/$defs/ProposalCompletionSubjects"
        },
        "checks": {
          "enum": [
            "not-run"
          ]
        },
        "complete": {
          "type": "boolean"
        }
      },
      "additionalProperties": true,
      "required": [
        "state",
        "open",
        "fill",
        "subjects",
        "checks",
        "complete"
      ]
    },
    "ProposalCompletionSubjects": {
      "type": "object",
      "properties": {
        "proposed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unknown": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "no-candidate": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rejected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "not-attempted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "proposed",
        "unknown",
        "no-candidate",
        "rejected",
        "not-attempted"
      ]
    },
    "ProposalControls": {
      "description": "c0369: the regeneration controls a reviewed viewer action repeats.",
      "type": "object",
      "properties": {
        "schema": {
          "enum": [
            "fenolite.proposal_controls.v0"
          ]
        },
        "router_options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "external_routers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "candidate_limit": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "requirements": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeout": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "gate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "portable": {
          "type": "boolean"
        }
      },
      "additionalProperties": true,
      "required": [
        "schema",
        "router_options",
        "external_routers",
        "nets",
        "kinds",
        "groups",
        "candidate_limit",
        "requirements",
        "timeout",
        "gate",
        "portable"
      ]
    },
    "ProposalCopper": {
      "type": "object",
      "properties": {
        "before": {
          "type": "integer"
        },
        "after": {
          "type": "integer"
        },
        "new": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProposalCopperFinding"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "before",
        "after",
        "new"
      ]
    },
    "ProposalCopperFinding": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "layer": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gap": {
          "type": "integer"
        }
      },
      "additionalProperties": true,
      "required": [
        "code",
        "layer",
        "items",
        "gap"
      ]
