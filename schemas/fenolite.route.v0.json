    "ProposalDrc": {
      "type": "object",
      "properties": {
        "new": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProposalDrcFinding"
          }
        },
        "evidence": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "new",
        "evidence"
      ]
    },
    "ProposalDrcFinding": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "type",
        "items"
      ]
    },
    "ProposalEnd": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "layers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "at": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      },
      "additionalProperties": true,
      "required": [
        "kind",
        "name",
        "layers"
      ]
    },
