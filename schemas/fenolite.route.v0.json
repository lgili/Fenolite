          "type": "array",
          "items": {
            "$ref": "#/$defs/ProposalExternalRefusal"
          }
        },
        "not_attempted": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProposalExternalNotAttempted"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "requested",
        "refusals",
        "not_attempted"
      ]
    },
