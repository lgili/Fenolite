        {
          "$ref": "#/$defs/GateSummary"
        },
        {
          "type": "null"
        }
      ]
    },
    "log": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "not_attempted": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RouteOpenItem"
          }
        },
        {
          "$ref": "#/$defs/ProposalOpen"
        }
      ]
    },
    "pairs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RoutePairsItem"
      }
    },
    "plane_fanout": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/RoutePlaneFanout"
        }
      ]
    },
    "plane_layers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resumed": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/RouteResumed"
        }
      ]
    },
    "rip_kept": {
      "$ref": "#/$defs/RouteRipKept"
    },
    "ripped": {
      "type": "integer"
    },
    "roles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RouteRolesItem"
      }
    },
    "routed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "router": {
      "type": "string"
    },
    "runs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RouteRunsItem"
      }
    },
    "selected": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tool_version": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        }
      ]
    },
    "tracks": {
      "type": "integer"
    },
    "unrouted": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "vias": {
      "type": "integer"
    },
    "mode": {
      "type": "string"
    },
    "order": {
      "type": "string"
    },
    "proposals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Proposal"
      }
    },
    "rejected": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProposalRejected"
      }
    },
    "locked": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProposalLocked"
      }
    },
    "next": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "accepted": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProposalAccepted"
      }
    },
    "decision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "record": {
      "type": "string"
    },
    "replayed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stale": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProposalStale"
      }
    },
    "forgotten": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "removed": {
      "type": "integer"
    },
    "drc_unattributed": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GateFinding"
      }
    },
    "bundles": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProposalBundle"
          }
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "controls": {
      "$ref": "#/$defs/ProposalControls"
    },
    "role_fields": {
      "$ref": "#/$defs/ProposalRoleFields"
    },
    "external": {
      "$ref": "#/$defs/ProposalExternal"
    },
    "completion": {
      "$ref": "#/$defs/ProposalCompletion"
    }
