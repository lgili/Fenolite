    },
    "issues_summary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProtocolIssueSummary"
      }
    },
    "recovery": {
      "$ref": "#/$defs/ProtocolRecovery"
    },
    "page": {
      "$ref": "#/$defs/ProtocolPage"
    },
    "native_check": {
      "enum": [
        "not-run",
        "candidate-facts",
        "acceptance-findings"
      ]
    },
    "board": {
      "type": "string"
    },
    "budget": {
      "$ref": "#/$defs/RouteBudget"
    },
    "connections": {
      "$ref": "#/$defs/RouteConnections"
    },
    "escape": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RouteEscapeItem"
      }
    },
    "fills_stale": {
      "type": "boolean"
    },
    "gate": {
