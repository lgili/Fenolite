{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fenolite.result.get.v0",
  "title": "GetResult",
  "type": "object",
  "properties": {
    "plan": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProtocolPlan"
      }
    },
    "plan_id": {
      "type": "string"
    },
    "issues_summary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProtocolIssueSummary"
      }
    },
    "recovery": {
      "$ref": "#/$defs/ProtocolRecovery"
    },
    "page": {
      "$ref": "#/$defs/ProtocolPage"
    },
    "accepted": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attribution": {
      "type": "string"
    },
    "cached": {
      "type": "boolean"
    },
    "downloads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GetDownloadsItem"
      }
    },
    "index_sha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        }
      ]
    },
    "item": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GetItemsItem"
      }
    },
    "licences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GetLicencesItem"
      }
    },
    "lock": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "origin": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        }
      ]
    },
    "release": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        }
      ]
    },
    "removes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GetRowsItem"
      }
    },
    "stage": {
      "type": "string"
    },
    "total": {
      "type": "integer"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "GetDownloadsItem": {
      "type": "object",
      "properties": {
        "asset": {
          "type": "string"
        },
        "bytes": {
          "type": "integer"
        },
        "origin": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "release": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "asset",
        "bytes",
        "origin",
        "path",
        "release",
        "sha256"
      ]
    },
    "GetItemsItem": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "after": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "before": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "bytes": {
          "type": "integer"
        },
        "evidence": {
          "type": "string"
        },
        "executes": {
          "type": "boolean"
        },
        "family": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "obligations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "path": {
          "type": "string"
        },
        "proof": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "reciprocal": {
          "type": "boolean"
        },
        "release": {
          "type": "string"
        },
        "required_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "spdx": {
          "type": "string"
        },
        "tree": {
          "type": "string"
        },
        "upstream": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/GetItemsItemUpstream"
            }
          ]
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "action",
        "after",
        "before",
        "id",
        "kind",
        "path",
        "version"
      ]
    },
    "GetItemsItemUpstream": {
      "type": "object",
      "properties": {
        "commit": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "commit",
        "url"
      ]
    },
    "GetLicencesItem": {
      "type": "object",
      "properties": {
        "accept_required": {
          "type": "boolean"
        },
        "accepted": {
          "type": "boolean"
        },
        "spdx": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "accept_required",
        "accepted",
        "spdx"
      ]
    },
    "GetRowsItem": {
      "type": "object",
      "properties": {
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "family": {
          "type": "string"
        },
        "gallery": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "modified": {
          "type": "boolean"
        },
        "newer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "type": "string"
        },
        "present": {
          "type": "boolean"
        },
        "release": {
          "type": "string"
        },
        "spdx": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "id",
        "kind",
        "spdx",
        "version"
      ]
    },
    "ProtocolIssueSummary": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "count": {
          "type": "integer"
        },
        "by_severity": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "x-fenolite-map": true,
          "description": "counts indexed by severity"
        }
      },
      "additionalProperties": true,
      "required": [
        "code",
        "count",
        "by_severity"
      ]
    },
    "ProtocolPage": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "limit": {
          "type": "integer"
        },
        "offset": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        },
        "next": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true,
      "required": [
        "path",
        "limit",
        "offset",
        "total",
        "next"
      ]
    },
    "ProtocolPlan": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "bytes": {
          "type": "integer"
        },
        "sha256": {
          "type": "string"
        },
        "overwrite": {
          "type": "boolean"
        }
      },
      "additionalProperties": true,
      "required": [
        "path",
        "kind",
        "bytes",
        "sha256",
        "overwrite"
      ]
    },
    "ProtocolRecovery": {
      "type": "object",
      "properties": {
        "failed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preserved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "failed",
        "preserved"
      ]
    }
  }
}
