{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fenolite.result.export.v0",
  "title": "ExportResult",
  "type": "object",
  "properties": {
    "plan": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProtocolPlan"
      }
    },
    "plan_id": {
      "type": "string"
    },
    "issues_summary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProtocolIssueSummary"
      }
    },
    "recovery": {
      "$ref": "#/$defs/ProtocolRecovery"
    },
    "page": {
      "$ref": "#/$defs/ProtocolPage"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ExportArtifactsItem"
      }
    },
    "board": {
      "type": "string"
    },
    "drawings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ExportDrawingsItem"
      }
    },
    "kinds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ExportModelsItem"
      }
    },
    "out": {
      "type": "string"
    },
    "preset": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/ExportPreset"
        }
      ]
    },
    "repeat": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "x-fenolite-map": true,
      "description": "Keys are supplied by named items, rather than fixed record fields."
    },
    "rules": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/ExportRules"
        }
      ]
    },
    "tool_version": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        }
      ]
    },
    "tool_writes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "ExportArtifactsItem": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer"
        },
        "content_sha256": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "layer": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "bytes",
        "content_sha256",
        "kind",
        "layer",
        "path",
        "sha256"
      ]
    },
    "ExportDrawingsItem": {
      "type": "object",
      "properties": {
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExportDrawingsItemBlocksItem"
          }
        },
        "designators_added": {
          "type": "integer"
        },
        "kind": {
          "type": "string"
        },
        "paper": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "portrait": {
          "type": "boolean"
        },
        "sheet": {
          "type": "string"
        },
        "side": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "blocks",
        "kind",
        "paper",
        "path",
        "portrait",
        "sheet"
      ]
    },
    "ExportDrawingsItemBlocksItem": {
      "type": "object",
      "properties": {
        "at": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "name": {
          "type": "string"
        },
        "size": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "at",
        "name",
        "size"
      ]
    },
    "ExportModelsItem": {
      "type": "object",
      "properties": {
        "bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "type": "string"
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "bytes",
        "path",
        "refs",
        "sha256",
        "source"
      ]
    },
    "ExportPreset": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "file",
        "sha256"
      ]
    },
    "ExportRules": {
      "type": "object",
      "properties": {
        "not_lowered": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExportRulesNotLoweredItem"
          }
        },
        "written": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExportRulesWrittenItem"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "not_lowered",
        "written"
      ]
    },
    "ExportRulesNotLoweredItem": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "selector": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "kind",
        "reason",
        "selector"
      ]
    },
    "ExportRulesWrittenItem": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "rule": {
          "type": "string"
        },
        "selector": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "kind",
        "rule",
        "selector"
      ]
    },
    "ProtocolIssueSummary": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "count": {
          "type": "integer"
        },
        "by_severity": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "x-fenolite-map": true,
          "description": "counts indexed by severity"
        }
      },
      "additionalProperties": true,
      "required": [
        "code",
        "count",
        "by_severity"
      ]
    },
    "ProtocolPage": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "limit": {
          "type": "integer"
        },
        "offset": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        },
        "next": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true,
      "required": [
        "path",
        "limit",
        "offset",
        "total",
        "next"
      ]
    },
    "ProtocolPlan": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "bytes": {
          "type": "integer"
        },
        "sha256": {
          "type": "string"
        },
        "overwrite": {
          "type": "boolean"
        }
      },
      "additionalProperties": true,
      "required": [
        "path",
        "kind",
        "bytes",
        "sha256",
        "overwrite"
      ]
    },
    "ProtocolRecovery": {
      "type": "object",
      "properties": {
        "failed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preserved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "failed",
        "preserved"
      ]
    }
  }
}
