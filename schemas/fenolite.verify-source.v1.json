{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fenolite.result.verify-source.v1",
  "title": "VerifySourceResult",
  "type": "object",
  "properties": {
    "plan": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProtocolPlan"
      }
    },
    "plan_id": {
      "type": "string"
    },
    "issues_summary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProtocolIssueSummary"
      }
    },
    "recovery": {
      "$ref": "#/$defs/ProtocolRecovery"
    },
    "page": {
      "$ref": "#/$defs/ProtocolPage"
    },
    "accepted": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/VerifySourceAcceptedItem"
      }
    },
    "against": {
      "$ref": "#/$defs/VerifySourceAgainst"
    },
    "build": {
      "$ref": "#/$defs/VerifySourceBuild"
    },
    "differences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/VerifySourceDifferencesItem"
      }
    },
    "equivalent": {
      "type": "boolean"
    },
    "levels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/VerifySourceLevelsItem"
      }
    },
    "new_accepted": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/VerifySourceNewAcceptedItem"
      }
    },
    "notices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/VerifySourceNoticesItem"
      }
    },
    "provenance": {
      "$ref": "#/$defs/VerifySourceProvenance"
    },
    "script": {
      "$ref": "#/$defs/VerifySourceScript"
    },
    "tolerances": {
      "$ref": "#/$defs/VerifySourceTolerances"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "CanonicalNativeJson": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CanonicalNativeJson"
          }
        }
      ]
    },
    "DerivedCacheCanonicalNets": {
      "description": "Every net paired under a canonical name, by rule: rows [side, declared name, pairing key].",
      "type": "object",
      "properties": {
        "slash": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "Nets whose stored {slash} was read as the / of their label text."
        },
        "unconnected_single_pad": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "unconnected-( nets of exactly one pad whose name KiCad derives from that pad, keyed by its reference and number."
        }
      },
      "additionalProperties": true,
      "required": [
        "slash",
        "unconnected_single_pad"
      ]
    },
    "DerivedCacheCrossings": {
      "type": "object",
      "properties": {
        "rings_with_proper_crossings": {
          "type": "integer",
          "minimum": 0
        },
        "proper_edge_pair_crossings": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true,
      "required": [
        "rings_with_proper_crossings",
        "proper_edge_pair_crossings"
      ]
    },
    "DerivedCacheIdentityPreparation": {
      "description": "Private identity and order preparation of side b's native input copy only (c0384 2.1). By c0275's",
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "private-native-input-copy"
          ]
        },
        "side": {
          "type": "string",
          "enum": [
            "b"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "applied",
            "unneeded",
            "refused"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "label": {
          "type": "string",
          "enum": [
            "L7",
            "L7 after identity preparation",
            "L7 after order preparation",
            "L7 after identity and order preparation"
          ]
        },
        "rewritten": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "Every rewritten object: [kind, side-b identity, side-a identity]."
        },
        "moved": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            }
          },
          "description": "Every moved root segment, arc or via: [kind, side-b identity, old position, new position], positions 0-based among the root segments, arcs and vias."
        },
        "identical_pairs": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "Side-b identities of each admitted pair of fully identical pads."
        },
        "source_aliases": {
          "$ref": "#/$defs/DerivedCacheSourceAliases"
        },
        "canonical_nets": {
          "$ref": "#/$defs/DerivedCacheCanonicalNets"
        }
      },
      "additionalProperties": true,
      "required": [
        "scope",
        "side",
        "status",
        "reason",
        "label",
        "rewritten",
        "moved",
        "identical_pairs",
        "source_aliases",
        "canonical_nets"
      ]
    },
    "DerivedCacheRuleDelta": {
      "description": "Uninterpreted native JSON canonicalization; not judged rule/geometry semantics.",
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "a": {
          "$ref": "#/$defs/CanonicalNativeJson"
        },
        "b": {
          "$ref": "#/$defs/CanonicalNativeJson"
        }
      },
      "additionalProperties": true,
      "required": [
        "key",
        "a",
        "b"
      ]
    },
    "DerivedCacheSettingDelta": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "a_canonical_sha256": {
          "type": "string"
        },
        "b_canonical_sha256": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "key",
        "a_canonical_sha256",
        "b_canonical_sha256"
      ]
    },
    "DerivedCacheSide": {
      "type": "object",
      "properties": {
        "raw_caches": {
          "type": "integer",
          "minimum": 0
        },
        "raw_non_simple_rings": {
          "$ref": "#/$defs/DerivedCacheCrossings"
        },
        "native_input_sha256": {
          "type": "string"
        },
        "qualified_caches_removed_from_private_input": {
          "type": "boolean",
          "enum": [
            true
          ]
        },
        "input_files": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "x-fenolite-map": true
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exit": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "type": "string"
        },
        "stdout_sha256": {
          "type": "string"
        },
        "stderr_sha256": {
          "type": "string"
        },
        "output_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "regenerated_caches": {
          "type": "integer",
          "minimum": 0
        },
        "native_non_simple_rings": {
          "$ref": "#/$defs/DerivedCacheCrossings"
        },
        "exact_geometry_sha256": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "raw_caches",
        "raw_non_simple_rings",
        "native_input_sha256",
        "qualified_caches_removed_from_private_input",
        "input_files",
        "command",
        "exit",
        "outcome",
        "stdout_sha256",
        "stderr_sha256",
        "output_sha256"
      ]
    },
    "DerivedCacheSides": {
      "type": "object",
      "properties": {
        "a": {
          "$ref": "#/$defs/DerivedCacheSide"
        },
        "b": {
          "$ref": "#/$defs/DerivedCacheSide"
        }
      },
      "additionalProperties": true
    },
    "DerivedCacheSourceAliases": {
      "type": "object",
      "properties": {
        "note": {
          "type": "string",
          "enum": [
            "source alias, not rewritten"
          ]
        },
        "count": {
          "type": "integer"
        },
        "identities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Side-b identities kept because their side-a identity names several objects."
        }
      },
      "additionalProperties": true,
      "required": [
        "note",
        "count",
        "identities"
      ]
    },
    "DerivedCacheSummary": {
      "description": "Existing common-tool receipt, not raw-cache equality or a DRC safety certificate.",
      "type": "object",
      "properties": {
        "judged_project_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unjudged_project_rule_deltas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DerivedCacheRuleDelta"
          }
        },
        "unjudged_project_setting_deltas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DerivedCacheSettingDelta"
          }
        },
        "whole_project_json_equality_claimed": {
          "type": "boolean",
          "enum": [
            false
          ]
        },
        "whole_native_rule_file_equality_claimed": {
          "type": "boolean",
          "enum": [
            false
          ]
        },
        "tool": {
          "type": "string",
          "enum": [
            "kicad-cli"
          ]
        },
        "version": {
          "type": "string"
        },
        "raw_cache_equality_claimed": {
          "type": "boolean",
          "enum": [
            false
          ]
        },
        "drc_safety_gate_claimed": {
          "type": "boolean",
          "enum": [
            false
          ]
        },
        "sides": {
          "$ref": "#/$defs/DerivedCacheSides"
        },
        "status": {
          "type": "string",
          "enum": [
            "equal",
            "differs",
            "native-failed",
            "native-config-changed",
            "native-cache-unqualified"
          ]
        },
        "complete_regenerated_geometry_equal": {
          "type": "boolean"
        },
        "normal_zone_priorities_normalized": {
          "type": "boolean",
          "enum": [
            false
          ]
        },
        "identity_preparation": {
          "$ref": "#/$defs/DerivedCacheIdentityPreparation"
        }
      },
      "additionalProperties": true,
      "required": [
        "judged_project_keys",
        "unjudged_project_rule_deltas",
        "unjudged_project_setting_deltas",
        "whole_project_json_equality_claimed",
        "whole_native_rule_file_equality_claimed",
        "tool",
        "version",
        "raw_cache_equality_claimed",
        "drc_safety_gate_claimed",
        "sides",
        "status"
      ]
    },
    "NativeProjectRulesSummary": {
      "description": "Scoped exact native context; unknown rule properties are explicitly outside coverage.",
      "type": "object",
      "properties": {
        "scope": {
          "type": "string"
        },
        "judged_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unjudged_absent_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "judged_count": {
          "type": "integer"
        },
        "source_major": {
          "type": "integer"
        },
        "generated_major": {
          "type": "integer"
        },
        "a_read_files": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "x-fenolite-map": true
        },
        "b_read_files": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "x-fenolite-map": true
        },
        "unjudged": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "scope",
        "judged_keys",
        "unjudged_absent_fields",
        "judged_count",
        "source_major",
        "generated_major",
        "a_read_files",
        "b_read_files",
        "unjudged"
      ]
    },
    "ProtocolIssueSummary": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "count": {
          "type": "integer"
        },
        "by_severity": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "x-fenolite-map": true,
          "description": "counts indexed by severity"
        }
      },
      "additionalProperties": true,
      "required": [
        "code",
        "count",
        "by_severity"
      ]
    },
    "ProtocolPage": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "limit": {
          "type": "integer"
        },
        "offset": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        },
        "next": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true,
      "required": [
        "path",
        "limit",
        "offset",
        "total",
        "next"
      ]
    },
    "ProtocolPlan": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "bytes": {
          "type": "integer"
        },
        "sha256": {
          "type": "string"
        },
        "overwrite": {
          "type": "boolean"
        }
      },
      "additionalProperties": true,
      "required": [
        "path",
        "kind",
        "bytes",
        "sha256",
        "overwrite"
      ]
    },
    "ProtocolRecovery": {
      "type": "object",
      "properties": {
        "failed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preserved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "failed",
        "preserved"
      ]
    },
    "VerifySourceAcceptedItem": {
      "type": "object",
      "properties": {
        "a": {
          "type": "string"
        },
        "b": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "level": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ]
        },
        "rule": {
          "type": "string"
        },
        "where": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "a",
        "b",
        "field",
        "kind",
        "level",
        "rule",
        "where"
      ]
    },
    "VerifySourceAgainst": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string"
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "x-fenolite-map": true,
          "description": "Keys are supplied by named items, rather than fixed record fields."
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "backend",
        "files",
        "name"
      ]
    },
    "VerifySourceBuild": {
      "type": "object",
      "properties": {
        "copper_check": {
          "type": "string"
        },
        "copy": {
          "type": "boolean"
        },
        "files": {
          "type": "integer"
        },
        "target": {
          "type": "string"
        },
        "read_files": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "x-fenolite-map": true,
          "description": "generated temporary build outputs read by the proof"
        }
      },
      "additionalProperties": true,
      "required": [
        "copper_check",
        "copy",
        "files",
        "target"
      ]
    },
    "VerifySourceDifferencesItem": {
      "type": "object",
      "properties": {
        "a": {
          "type": "string"
        },
        "b": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "level": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ]
        },
        "where": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "a",
        "b",
        "field",
        "kind",
        "level",
        "where"
      ]
    },
    "VerifySourceLevelsItem": {
      "type": "object",
      "properties": {
        "compared": {
          "type": "integer"
        },
        "differences": {
          "type": "integer"
        },
        "excluded": {
          "type": "integer"
        },
        "level": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "notices": {
          "type": "integer"
        },
        "reason": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/VerifySourceLevelsItemSummary"
        }
      },
      "additionalProperties": true,
      "required": [
        "compared",
        "differences",
        "excluded",
        "level",
        "name",
        "notices",
        "reason",
        "status",
        "summary"
      ]
    },
    "VerifySourceLevelsItemSummary": {
      "type": "object",
      "properties": {
        "derived_cache": {
          "$ref": "#/$defs/DerivedCacheSummary"
        },
        "project_geometry": {
          "type": "integer"
        },
        "native_project_rules": {
          "$ref": "#/$defs/NativeProjectRulesSummary"
        },
        "changes": {
          "$ref": "#/$defs/VerifySourceLevelsItemSummaryChanges"
        },
        "components": {
          "$ref": "#/$defs/VerifySourceLevelsItemSummaryComponents"
        },
        "copper_no_net": {
          "$ref": "#/$defs/VerifySourceLevelsItemSummaryCopperNoNet"
        },
        "copper_unknown": {
          "type": "integer"
        },
        "dimensions": {
          "type": "integer"
        },
        "extraction_issues": {
          "type": "integer"
        },
        "footprint_items": {
          "type": "integer"
        },
        "footprints": {
          "type": "integer"
        },
        "frame": {
          "type": "string"
        },
        "graphics": {
          "type": "integer"
        },
        "holes": {
          "type": "integer"
        },
        "ignored": {
          "type": "integer"
        },
        "instances": {
          "type": "integer"
        },
        "items": {
          "type": "integer"
        },
        "keepouts": {
          "type": "integer"
        },
        "layers": {
          "type": "integer"
        },
        "length": {
          "$ref": "#/$defs/VerifySourceLevelsItemSummaryLength"
        },
        "netclasses": {
          "type": "integer"
        },
        "nets": {
          "type": "integer"
        },
        "nets_unpaired": {
          "$ref": "#/$defs/VerifySourceLevelsItemSummaryNetsUnpaired"
        },
        "opaque": {
          "type": "integer"
        },
        "outline": {
          "type": "integer"
        },
        "pieces": {
          "$ref": "#/$defs/VerifySourceLevelsItemSummaryPieces"
        },
        "pins": {
          "type": "integer"
        },
        "pitch_nm": {
          "$ref": "#/$defs/VerifySourceLevelsItemSummaryPitchNm"
        },
        "pixel_ppm": {
          "type": "integer"
        },
        "renamed": {
          "type": "integer"
        },
        "rules": {
          "type": "integer"
        },
        "sheets": {
          "type": "integer"
        },
        "sources": {
          "$ref": "#/$defs/VerifySourceLevelsItemSummarySources"
        },
        "stackup": {
          "type": "integer"
        },
        "strict": {
          "$ref": "#/$defs/VerifySourceLevelsItemSummaryStrict"
        },
        "symbols": {
          "type": "integer"
        },
        "texts": {
          "type": "integer"
        },
        "translation": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "unjudged": {
          "type": "integer"
        },
        "unnumbered": {
          "$ref": "#/$defs/VerifySourceLevelsItemSummaryUnnumbered"
        },
        "unshaped": {
          "$ref": "#/$defs/VerifySourceLevelsItemSummaryUnshaped"
        },
        "vias": {
          "$ref": "#/$defs/VerifySourceLevelsItemSummaryVias"
        },
        "zones": {
          "type": "integer"
        },
        "zones_unfilled": {
          "$ref": "#/$defs/VerifySourceLevelsItemSummaryZonesUnfilled"
        }
      },
      "additionalProperties": true
    },
    "VerifySourceLevelsItemSummaryChanges": {
      "type": "object",
      "properties": {
        "board": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "VerifySourceLevelsItemSummaryComponents": {
      "type": "object",
      "properties": {
        "a": {
          "type": "integer"
        },
        "b": {
          "type": "integer"
        }
      },
      "additionalProperties": true,
      "required": [
        "a",
        "b"
      ]
    },
    "VerifySourceLevelsItemSummaryCopperNoNet": {
      "type": "object",
      "properties": {
        "a": {
          "type": "integer"
        },
        "b": {
          "type": "integer"
        }
      },
      "additionalProperties": true,
      "required": [
        "a",
        "b"
      ]
    },
    "VerifySourceLevelsItemSummaryLength": {
      "type": "object",
      "properties": {
        "a": {
