{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fenolite.result.place.v0",
  "title": "PlaceResult",
  "type": "object",
  "properties": {
    "plan": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProtocolPlan"
      }
    },
    "plan_id": {
      "type": "string"
    },
    "issues_summary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProtocolIssueSummary"
      }
    },
    "recovery": {
      "$ref": "#/$defs/ProtocolRecovery"
    },
    "page": {
      "$ref": "#/$defs/ProtocolPage"
    },
    "board": {
      "type": "string"
    },
    "group": {
      "$ref": "#/$defs/PlaceGroup"
    },
    "legality": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      },
      "x-fenolite-map": true,
      "description": "Keys are supplied by named items, rather than fixed record fields."
    },
    "measures": {
      "$ref": "#/$defs/PlaceMeasures"
    },
    "moved": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PlaceMovedItem"
      }
    },
    "optimization": {
      "$ref": "#/$defs/PlacementOptimization"
    },
    "placement": {
      "$ref": "#/$defs/PlacePlacement"
    },
    "preview": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/PlacePreview"
        }
      ]
    },
    "regions": {
      "$ref": "#/$defs/PlaceRegions"
    },
    "reuse": {
      "$ref": "#/$defs/PlaceReuse"
    },
    "rules": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/PlaceRulesValue"
      },
      "x-fenolite-map": true,
      "description": "Keys are supplied by named items, rather than fixed record fields."
    },
    "strategy": {
      "type": "string"
    },
    "unplaced": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "CopperRef": {
      "description": "One item of a finding: its kind, where it is (``REF-PIN`` for a pad, else the entity's locator or",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "track",
            "arc",
            "via",
            "pad",
            "fill",
            "zone",
            "keepout",
            "edge",
            "hole",
            "graphic"
          ]
        },
        "where": {
          "type": "string"
        },
        "entity_id": {
          "type": "string"
        },
        "net": {
          "type": "string"
        },
        "footprint_id": {
          "type": "string"
        },
        "net_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true,
      "required": [
        "kind",
        "where",
        "entity_id",
        "net",
        "footprint_id",
        "net_id"
      ]
    },
    "ObjectiveMeasure": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "first_pad": {
          "type": "string"
        },
        "second_pad": {
          "type": "string"
        },
        "squared_distance_nm": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "distance_nm": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "contribution_nm": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "max_distance_nm": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "key",
        "first_pad",
        "second_pad",
        "squared_distance_nm",
        "distance_nm",
        "contribution_nm",
        "max_distance_nm",
        "status",
        "reason"
      ]
    },
    "OptimizationCandidate": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "poses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProposedPose"
          }
        },
        "score": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "missing_inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "channel_overflow_by_layer": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "x-fenolite-map": true
        },
        "probes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PadProbe"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "id",
        "poses",
        "score",
        "missing_inputs"
      ]
    },
    "PadIdentity": {
      "type": "object",
      "properties": {
        "footprint_id": {
          "type": "string"
        },
        "pad_id": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "footprint_id",
        "pad_id"
      ]
    },
    "PadProbe": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "length_nm": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "expanded": {
          "type": "integer"
        }
      },
      "additionalProperties": true,
      "required": [
        "key",
        "status"
      ]
    },
    "PlaceGroup": {
      "type": "object",
      "properties": {
        "copper": {
          "$ref": "#/$defs/PlaceGroupCopper"
        },
        "copper_check": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/PlaceGroupCopperCheck"
            }
          ]
        },
        "kind": {
          "type": "string"
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "residual": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "search": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/PlaceGroupSearch"
            }
          ]
        },
        "transform": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/PlaceGroupTransform"
            }
          ]
        }
      },
      "additionalProperties": true,
      "required": [
        "copper",
        "copper_check",
        "kind",
        "refs",
        "residual",
        "search",
        "transform"
      ]
    },
    "PlaceGroupCopper": {
      "type": "object",
      "properties": {
        "items": {
          "type": "integer"
        },
        "zones": {
          "type": "integer"
        }
      },
      "additionalProperties": true,
      "required": [
        "items",
        "zones"
      ]
    },
    "PlaceGroupCopperCheck": {
      "type": "object",
      "properties": {
        "after": {
          "type": "integer"
        },
        "before": {
          "type": "integer"
        },
        "new": {
          "type": "integer"
        }
      },
      "additionalProperties": true,
      "required": [
        "after",
        "before",
        "new"
      ]
    },
    "PlaceGroupSearch": {
      "type": "object",
      "properties": {
        "about": {
          "$ref": "#/$defs/PlaceGroupSearchAbout"
        },
        "current": {
          "type": "integer"
        },
        "nets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pitch": {
          "type": "integer"
        },
        "poses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlaceGroupSearchPosesItem"
          }
        },
        "tried": {
          "type": "integer"
        },
        "within": {
          "type": "integer"
        }
      },
      "additionalProperties": true,
      "required": [
        "about",
        "current",
        "nets",
        "pitch",
        "poses",
        "tried",
        "within"
      ]
    },
    "PlaceGroupSearchAbout": {
      "type": "object",
