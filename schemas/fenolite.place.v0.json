              "x-fenolite-map": true
            }
          ]
        },
        "pitch": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "tracks_per_layer": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true,
      "required": [
        "busiest",
        "cell",
        "layers_needed",
        "pitch",
        "tracks_per_layer"
      ]
