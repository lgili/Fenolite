        "y": {
          "type": "integer"
        }
      },
      "additionalProperties": true,
      "required": [
        "rotation",
        "x",
        "y"
      ]
    },
    "PlaceMeasures": {
      "type": "object",
      "properties": {
        "change": {
          "$ref": "#/$defs/PlaceMeasuresChange"
