        "longest": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlaceMeasuresLongestItem"
          }
        },
        "nets": {
          "type": "integer"
        },
        "ratsnest": {
          "type": "integer"
        }
      },
      "additionalProperties": true,
      "required": [
        "change",
        "congestion",
        "hpwl",
        "left_out",
        "longest",
        "nets",
        "ratsnest"
      ]
    },
    "PlaceMeasuresChange": {
      "type": "object",
      "properties": {
        "hpwl": {
          "type": "integer"
