          "type": "integer"
        },
        "y": {
          "type": "integer"
        }
      },
      "additionalProperties": true,
      "required": [
        "rotation",
        "side",
        "x",
        "y"
      ]
    },
    "PlaceMovedItemTo": {
      "type": "object",
      "properties": {
        "rotation": {
          "type": "integer"
        },
        "side": {
          "type": "string"
        },
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        }
      },
      "additionalProperties": true,
      "required": [
        "rotation",
        "side",
        "x",
        "y"
