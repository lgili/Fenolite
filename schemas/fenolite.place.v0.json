        "selected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_sha256": {
          "type": "string"
        },
        "unplaced": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Unplaced"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "assessment",
        "candidate_counts",
        "constraints",
        "hard_findings",
        "intrinsic",
        "missing_inputs",
        "objective_metric",
        "objectives",
        "positions",
        "request_sha256",
        "selected",
        "source_sha256",
        "unplaced"
      ]
    },
    "PlacePlacementAssessment": {
      "type": "object",
