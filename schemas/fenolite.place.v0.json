    "PlaceMeasuresCongestionBusiestItem": {
      "type": "object",
      "properties": {
        "tracks": {
          "type": "integer"
        },
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        }
      },
      "additionalProperties": true,
      "required": [
        "tracks",
        "x",
        "y"
