      }
    },
    "arcs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Arc"
      }
    },
    "vias": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Via"
      }
    },
    "zones": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Zone"
      }
    },
    "keepouts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Keepout"
      }
