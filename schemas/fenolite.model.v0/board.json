        },
        "native_ids": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ]
        },
        "ext": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ExtBag"
          }
        },
        "name": {
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Point"
        },
        "layer": {
          "type": "string"
        },
        "size": {
          "$ref": "#/$defs/Size"
        },
        "rotation": {
          "type": "integer"
