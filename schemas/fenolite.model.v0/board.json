        "ext": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ExtBag"
          }
        },
        "outline": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Point"
          }
        },
        "layers": {
          "type": "array",
          "items": {
            "type": "string"
          }
