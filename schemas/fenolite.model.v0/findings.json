{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fenolite.findings.v0",
  "title": "Findings",
  "description": "The findings layer of a design (``findings.json``). ``waivers`` are sorted by name.",
  "type": "object",
  "properties": {
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Issue"
      }
    },
    "waivers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Waiver"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Issue": {
      "description": "A finding reported by a command. Findings of severity ``error`` make the exit code 5.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9-]+)+$"
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "message": {
          "type": "string"
        },
        "where": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "message"
      ]
    },
    "Waiver": {
      "description": "The acceptance of one finding, with a reason (change c0114).",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        },
        "min_gap": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "code",
        "items",
        "reason"
      ]
    }
  }
}
