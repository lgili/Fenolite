{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fenolite.findings.v0",
  "title": "Findings",
  "description": "The findings layer of a design (``findings.json``).",
  "type": "object",
  "properties": {
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Issue"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Issue": {
      "description": "A finding reported by a command. Findings of severity ``error`` make the exit code 5.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9-]+)+$"
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "message": {
          "type": "string"
        },
        "where": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "message"
      ]
    }
  }
}
