{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fenolite.library.v0",
  "title": "Library",
  "description": "A set of definitions under one name (the schema root of ``library.json``).",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "footprints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FootprintDef"
      }
    },
    "symbols": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SymbolDef"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ComponentBody": {
      "description": "The physical body of a part: a volume above the side its footprint is placed on.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]{2,3}_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "native_ids": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ]
        },
        "ext": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ExtBag"
          }
        },
        "kind": {
          "enum": [
            "extruded",
            "model"
          ]
        },
        "height": {
          "type": "integer"
        },
        "standoff": {
          "type": "integer"
        },
        "outline": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Point"
          }
        },
        "layer": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "height"
      ]
    },
    "Evidence": {
      "description": "A level plus the oracle that produced it and the hypotheses it depends on.",
      "type": "object",
      "properties": {
        "level": {
          "enum": [
            "ALTIUM-VERIFIED(kit)",
            "KICAD-VERIFIED",
            "ORACLE-VERIFIED",
            "CORPUS-VERIFIED",
            "ALTIUM-VERIFIED(author-report)",
            "INFERRED",
            "UNKNOWN",
            "UNVERIFIED"
          ]
        },
        "oracle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "hypotheses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "ExtBag": {
      "description": "What a backend knows about an object and the model does not: verbatim fragments.",
      "type": "object",
      "properties": {
        "min_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "payload": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "items": false
          }
        }
      },
      "additionalProperties": false
    },
    "FootprintDef": {
      "description": "A footprint of a library. ``properties`` is sorted by key in the canonical form.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]{2,3}_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "native_ids": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ]
        },
        "ext": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ExtBag"
          }
        },
        "name": {
          "type": "string"
        },
        "library": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kind": {
          "enum": [
            "smd",
            "through_hole",
            "unspecified"
          ]
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "pads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Pad"
          }
        },
        "graphics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Graphic"
          }
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bodies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComponentBody"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ]
    },
    "Graphic": {
      "description": "A drawing primitive on a non-copper or copper layer; ``points`` meaning depends on ``kind``.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]{2,3}_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "native_ids": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ]
        },
        "ext": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ExtBag"
          }
        },
        "kind": {
          "enum": [
            "line",
            "arc",
            "circle",
            "rect",
            "polygon"
          ]
        },
        "layer": {
          "type": "string"
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Point"
          }
        },
        "width": {
          "type": "integer"
        },
        "filled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "layer",
        "points"
      ]
    },
    "Pad": {
      "description": "A pad of a footprint; ``position`` and ``rotation`` are relative to the footprint.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]{2,3}_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "native_ids": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ]
        },
        "ext": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ExtBag"
          }
        },
        "number": {
          "type": "string"
        },
        "shape": {
          "enum": [
            "circle",
            "rect",
            "oval",
            "roundrect",
            "trapezoid",
            "custom"
          ]
        },
        "size": {
          "$ref": "#/$defs/Size"
        },
        "position": {
          "$ref": "#/$defs/Point"
        },
        "kind": {
          "enum": [
            "smd",
            "thru_hole",
            "np_thru_hole",
            "connect"
          ]
        },
        "rotation": {
          "type": "integer"
        },
        "drill": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "layers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "net_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "padstack": {
          "anyOf": [
            {
              "$ref": "#/$defs/Padstack"
            },
            {
              "type": "null"
            }
          ]
        },
        "zone_connection": {
          "anyOf": [
            {
              "enum": [
                "solid",
                "thermal",
                "none",
                "thru_hole_only"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "corner_ratio": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "number",
        "shape",
        "size",
        "position"
      ]
    },
    "Padstack": {
      "description": "Per-layer shapes of a pad; absent when the pad has one shape on all its layers.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]{2,3}_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "native_ids": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ]
        },
        "ext": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ExtBag"
          }
        },
        "layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PadstackLayer"
          }
        },
        "hole_shape": {
          "enum": [
            "round",
            "square",
            "slot"
          ]
        },
        "hole_length": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "hole_rotation": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "PadstackLayer": {
      "description": "Pad shape on one layer (for pads whose shape differs per layer).",
      "type": "object",
      "properties": {
        "layer": {
          "type": "string"
        },
        "shape": {
          "enum": [
            "circle",
            "rect",
            "oval",
            "roundrect",
            "trapezoid",
            "custom"
          ]
        },
        "size": {
          "$ref": "#/$defs/Size"
        },
        "offset": {
          "$ref": "#/$defs/Point"
        }
      },
      "additionalProperties": false,
      "required": [
        "layer",
        "shape",
        "size"
      ]
    },
    "PinAlternate": {
      "description": "An alternate function of a pin.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "etype": {
          "enum": [
            "input",
            "output",
            "bidirectional",
            "tri_state",
            "passive",
            "free",
            "unspecified",
            "power_in",
            "power_out",
            "open_collector",
            "open_emitter",
            "no_connect"
          ]
        },
        "shape": {
          "enum": [
            "line",
            "inverted",
            "clock",
            "inverted_clock",
            "input_low",
            "clock_low",
            "output_low",
            "edge_clock_high",
            "non_logic"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "etype",
        "shape"
      ]
    },
    "Point": {
      "description": "A position in nanometres.",
      "type": "object",
      "properties": {
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ]
    },
    "Provenance": {
      "description": "Origin of an imported object. ``locator`` is opaque outside the originating backend.",
      "type": "object",
      "properties": {
        "backend": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "file_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "locator": {
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      },
      "additionalProperties": false,
      "required": [
        "backend",
        "file",
        "file_sha256",
        "locator"
      ]
    },
    "Size": {
      "description": "A width and height in nanometres.",
      "type": "object",
      "properties": {
        "w": {
          "type": "integer"
        },
        "h": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "required": [
        "w",
        "h"
      ]
    },
    "SymbolDef": {
      "description": "A symbol of a library. A derived symbol read as written has ``extends`` set and no pins.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]{2,3}_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "native_ids": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ]
        },
        "ext": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ExtBag"
          }
        },
        "name": {
          "type": "string"
        },
        "library": {
          "type": "string"
        },
        "extends": {
          "type": "string"
        },
        "power": {
          "enum": [
            "",
            "global",
            "local"
          ]
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "in_bom": {
          "type": "boolean"
        },
        "on_board": {
          "type": "boolean"
        },
        "exclude_from_sim": {
          "type": "boolean"
        },
        "pin_names_hidden": {
          "type": "boolean"
        },
        "pin_numbers_hidden": {
          "type": "boolean"
        },
        "pin_name_offset": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "units": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SymbolUnit"
          }
        },
        "pins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SymbolPin"
          }
        },
        "graphics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SymbolGraphic"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ]
    },
    "SymbolGraphic": {
      "description": "A vector primitive in symbol-local coordinates (nanometres).",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "line",
            "circle",
            "rect",
            "polygon"
          ]
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Point"
          }
        },
        "width": {
          "type": "integer"
        },
        "filled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "points"
      ]
    },
    "SymbolPin": {
      "description": "A pin of a symbol; ``position`` is its connection point, ``rotation`` 0/90/180/270 degrees.",
      "type": "object",
      "properties": {
        "number": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "etype": {
          "enum": [
            "input",
            "output",
            "bidirectional",
            "tri_state",
            "passive",
            "free",
            "unspecified",
            "power_in",
            "power_out",
            "open_collector",
            "open_emitter",
            "no_connect"
          ]
        },
        "position": {
          "$ref": "#/$defs/Point"
        },
        "shape": {
          "enum": [
            "line",
            "inverted",
            "clock",
            "inverted_clock",
            "input_low",
            "clock_low",
            "output_low",
            "edge_clock_high",
            "non_logic"
          ]
        },
        "rotation": {
          "type": "integer"
        },
        "length": {
          "type": "integer"
        },
        "unit": {
          "type": "integer"
        },
        "body_style": {
          "type": "integer"
        },
        "hidden": {
          "type": "boolean"
        },
        "alternates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PinAlternate"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "number",
        "name",
        "etype",
        "position"
      ]
    },
    "SymbolUnit": {
      "description": "One unit/body-style combination of a symbol.",
      "type": "object",
      "properties": {
        "unit": {
          "type": "integer"
        },
        "body_style": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "unit",
        "body_style"
      ]
    }
  }
}
