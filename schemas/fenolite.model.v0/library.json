          "type": "boolean"
        },
        "unit": {
          "type": "integer"
        },
        "body_style": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "points"
      ]
    },
    "SymbolPin": {
      "description": "A pin of a symbol; ``position`` is its connection point, ``rotation`` 0/90/180/270 degrees.",
      "type": "object",
      "properties": {
        "number": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "etype": {
          "enum": [
            "input",
            "output",
            "bidirectional",
            "tri_state",
            "passive",
            "free",
            "unspecified",
