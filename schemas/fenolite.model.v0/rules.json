{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fenolite.rules.v0",
  "title": "RuleSet",
  "description": "The rules layer of a design (``rules.json``). ``severities`` gives the checks of a design-rule tool",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]{2,3}_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "native_ids": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "provenance": {
      "anyOf": [
        {
          "$ref": "#/$defs/Provenance"
        },
        {
          "type": "null"
        }
      ]
    },
    "ext": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ExtBag"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Rule"
      }
    },
    "severities": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "error",
          "warning",
          "ignore"
        ]
      }
    },
    "proximity": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProximityRule"
      }
    },
    "heights": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/HeightLimit"
      }
    },
    "impedance": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ImpedanceTarget"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "id"
  ],
  "$defs": {
    "Evidence": {
      "description": "A level plus the oracle that produced it and the hypotheses it depends on.",
      "type": "object",
      "properties": {
        "level": {
          "enum": [
            "ALTIUM-VERIFIED(kit)",
            "KICAD-VERIFIED",
            "ORACLE-VERIFIED",
            "CORPUS-VERIFIED",
            "ALTIUM-VERIFIED(author-report)",
            "INFERRED",
            "UNKNOWN",
            "UNVERIFIED"
          ]
        },
        "oracle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "hypotheses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "ExtBag": {
      "description": "What a backend knows about an object and the model does not: verbatim fragments.",
      "type": "object",
      "properties": {
        "min_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "payload": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "items": false
          }
        }
      },
      "additionalProperties": false
    },
    "HeightLimit": {
      "description": "A height limit: the parts under every rule area named ``area`` stay at most ``max`` tall.",
      "type": "object",
      "properties": {
        "area": {
          "type": "string"
        },
        "max": {
          "type": "integer"
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "area",
        "max"
      ]
    },
    "ImpedanceTarget": {
      "description": "An impedance target of net classes (change c0105): its name, kind, the ids of the classes it",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]{2,3}_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "native_ids": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ]
        },
        "ext": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ExtBag"
          }
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "single",
            "differential"
          ]
        },
        "netclass_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ohms": {
          "type": "string"
        },
        "tolerance_percent": {
          "type": "string"
        },
        "layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TraceGeometry"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "netclass_ids",
        "ohms"
      ]
    },
    "PadSelection": {
      "description": "Pads of one part, named by its component path.",
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "number": {
          "type": "string"
        },
        "index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "path"
      ]
    },
    "Provenance": {
      "description": "Origin of an imported object. ``locator`` is opaque outside the originating backend.",
      "type": "object",
      "properties": {
        "backend": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "file_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "locator": {
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      },
      "additionalProperties": false,
      "required": [
        "backend",
        "file",
        "file_sha256",
        "locator"
      ]
    },
    "ProximityRule": {
      "description": "A placement rule: each part of ``parts`` stays near a pad of ``anchor``.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PadSelection"
          }
        },
        "anchor": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PadSelection"
          }
        },
        "within": {
          "type": "integer"
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "parts",
        "anchor",
        "within"
      ]
    },
    "Rule": {
      "description": "One design rule. Binary rules (clearance, creepage) use ``selector_b`` for the second object.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]{2,3}_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "native_ids": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ]
        },
        "ext": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ExtBag"
          }
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "clearance",
            "track_width",
            "via_diameter",
            "via_drill",
            "hole_size",
            "edge_clearance",
            "hole_to_hole",
            "hole_clearance",
            "annular_width",
            "courtyard_clearance",
            "silk_clearance",
            "creepage",
            "no_tracks",
            "diff_pair_gap",
            "diff_pair_uncoupled",
            "skew",
            "diff_pair_skew",
            "length"
          ]
        },
        "selector_a": {
          "$ref": "#/$defs/Selector"
        },
        "selector_b": {
          "anyOf": [
            {
              "$ref": "#/$defs/Selector"
            },
            {
              "type": "null"
            }
          ]
        },
        "layers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "min": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "opt": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "max": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "ignore"
          ]
        },
        "priority": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "selector_a"
      ]
    },
    "Selector": {
      "description": "A small predicate algebra. Leaf values are globs such as ``PWR_*`` or ``U*``.",
      "type": "object",
      "properties": {
        "op": {
          "enum": [
            "all",
            "net",
            "netclass",
            "ref",
            "layer",
            "item_kind",
            "area",
            "diff_pair",
            "and",
            "or",
            "not"
          ]
        },
        "value": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Selector"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "op"
      ]
    },
    "TraceGeometry": {
      "description": "One layer of an impedance target: the signal layer, its one or two reference layers in stack",
      "type": "object",
      "properties": {
        "layer": {
          "type": "string"
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "width": {
          "type": "integer"
        },
        "gap": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "layer",
        "references",
        "width"
      ]
    }
  }
}
