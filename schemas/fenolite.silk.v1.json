{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fenolite.result.silk.v1",
  "title": "SilkResult",
  "type": "object",
  "properties": {
    "plan": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProtocolPlan"
      }
    },
    "plan_id": {
      "type": "string"
    },
    "issues_summary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProtocolIssueSummary"
      }
    },
    "recovery": {
      "$ref": "#/$defs/ProtocolRecovery"
    },
    "page": {
      "$ref": "#/$defs/ProtocolPage"
    },
    "aligned": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "board": {
      "type": "string"
    },
    "changed": {
      "type": "boolean"
    },
    "clip": {
      "anyOf": [
        {
          "$ref": "#/$defs/SilkClip"
        },
        {
          "type": "null"
        }
      ]
    },
    "drc": {
      "anyOf": [
        {
          "$ref": "#/$defs/DrcDifference"
        },
        {
          "type": "null"
        }
      ]
    },
    "kept": {
      "type": "integer"
    },
    "library": {
      "anyOf": [
        {
          "$ref": "#/$defs/SilkLibrary"
        },
        {
          "type": "null"
        }
      ]
    },
    "measure": {
      "$ref": "#/$defs/SilkMeasure"
    },
    "placed": {
      "type": "integer"
    },
    "placements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SilkPlacementsItem"
      }
    },
    "settings": {
      "$ref": "#/$defs/SilkSettings"
    },
    "target": {
      "type": "string"
    },
    "unplaced": {
      "type": "integer"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "DrcDifference": {
      "type": "object",
      "properties": {
        "tool_version": {
          "type": "string"
        },
        "before": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "x-fenolite-map": true,
          "description": "original DRC counts indexed by violation kind"
        },
        "after": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "x-fenolite-map": true,
          "description": "new DRC counts indexed by violation kind"
        },
        "new": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "tool_version",
        "before",
        "after",
        "new"
      ]
    },
    "ProtocolIssueSummary": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "count": {
          "type": "integer"
        },
        "by_severity": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "x-fenolite-map": true,
          "description": "counts indexed by severity"
        }
      },
      "additionalProperties": true,
      "required": [
        "code",
        "count",
        "by_severity"
      ]
    },
    "ProtocolPage": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "limit": {
          "type": "integer"
        },
        "offset": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        },
        "next": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true,
      "required": [
        "path",
        "limit",
        "offset",
        "total",
        "next"
      ]
    },
    "ProtocolPlan": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "bytes": {
          "type": "integer"
        },
        "sha256": {
          "type": "string"
        },
        "overwrite": {
          "type": "boolean"
        }
      },
      "additionalProperties": true,
      "required": [
        "path",
        "kind",
        "bytes",
        "sha256",
        "overwrite"
      ]
    },
    "ProtocolRecovery": {
      "type": "object",
      "properties": {
        "failed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preserved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "failed",
        "preserved"
      ]
    },
    "SilkClip": {
      "type": "object",
      "properties": {
        "margin": {
          "type": "integer"
        },
        "margin_source": {
          "type": "string"
        },
        "openings": {
          "type": "integer"
        },
        "items": {
          "type": "integer"
        },
        "pieces": {
          "type": "integer"
        },
        "dropped": {
          "type": "integer"
        },
        "cuts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SilkCut"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "margin",
        "margin_source",
        "openings",
        "items",
        "pieces",
        "dropped",
        "cuts"
      ]
    },
    "SilkCut": {
      "type": "object",
      "properties": {
        "owner": {
          "type": "string"
        },
        "footprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "side": {
          "type": "string"
        },
        "items": {
          "type": "integer"
        },
        "pieces": {
          "type": "integer"
        },
        "dropped": {
          "type": "integer"
        },
        "by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "owner",
        "footprint",
        "side",
        "items",
        "pieces",
        "dropped",
        "by"
      ]
    },
    "SilkLibrary": {
      "type": "object",
      "properties": {
        "changed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "command": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "changed",
        "command"
      ]
    },
    "SilkMeasure": {
      "type": "object",
      "properties": {
        "cached": {
          "type": "integer"
        },
        "source": {
          "type": "string"
        },
        "texts": {
          "type": "integer"
        }
      },
      "additionalProperties": true,
      "required": [
        "cached",
        "source",
        "texts"
      ]
    },
    "SilkPlacementsItem": {
      "type": "object",
      "properties": {
        "angle": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "ref": {
          "type": "string"
        },
        "side": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "stroke": {
          "type": "integer"
        },
        "where": {
          "type": "string"
        },
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        }
      },
      "additionalProperties": true,
      "required": [
        "angle",
        "height",
        "ref",
        "side",
        "status",
        "stroke",
        "where",
        "x",
        "y"
      ]
    },
    "SilkSettings": {
      "type": "object",
      "properties": {
        "angles": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "clearance": {
          "type": "integer"
        },
        "gap": {
          "type": "integer"
        },
        "keep": {
          "type": "boolean"
        },
        "min_height": {
          "type": "integer"
        },
        "min_stroke": {
          "type": "integer"
        },
        "sizes": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true,
      "required": [
        "angles",
        "clearance",
        "gap",
        "keep",
        "min_height",
        "min_stroke",
        "sizes"
      ]
    }
  }
}
