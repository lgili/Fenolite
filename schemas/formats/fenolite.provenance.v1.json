{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fenolite.provenance.v1",
  "title": "ProvenanceFile",
  "type": "object",
  "properties": {
    "schema": {
      "const": "fenolite.provenance.v1"
    },
    "kind": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "spdx": {
      "type": "string"
    },
    "origin": {
      "enum": [
        "converted",
        "authored",
        "seeded"
      ]
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "modification_notice": {
      "type": "string"
    },
    "upstream": {
      "anyOf": [
        {
          "$ref": "#/$defs/Upstream"
        },
        {
          "type": "null"
        }
      ]
    },
    "copyright": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "licence_text_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence": {
      "type": "string"
    },
    "trademarks": {
      "$ref": "#/$defs/Trademarks"
    },
    "featured": {
      "anyOf": [
        {
          "$ref": "#/$defs/Featured"
        },
        {
          "type": "null"
        }
      ]
    },
    "licence_review": {
      "anyOf": [
        {
          "$ref": "#/$defs/LicenceReview"
        },
        {
          "type": "null"
        }
      ]
    },
    "conversion": {
      "$ref": "#/$defs/Conversion"
    },
    "import": {
      "$ref": "#/$defs/EmbeddedImport"
    },
    "fidelity": {
      "$ref": "#/$defs/Fidelity"
    },
    "sources": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "library": {
      "type": "object",
      "description": "Caller-supplied library metadata preserved verbatim by verify-source; its keys and JSON values are not interpreted."
    },
    "replay": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ]
      }
    },
    "regeneration": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schema"
  ],
  "$defs": {
    "CanonicalNativeJson": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CanonicalNativeJson"
          }
        }
      ]
    },
    "Conversion": {
      "type": "object",
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConversionTool"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConversionStep"
          }
        },
        "outputs_tree": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "tools",
        "steps",
        "outputs_tree"
      ]
    },
    "ConversionStep": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string"
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "tool",
        "argv"
      ]
    },
    "ConversionTool": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ]
    },
    "DerivedCacheCanonicalNets": {
      "description": "Every net paired under a canonical name, by rule: rows [side, declared name, pairing key].",
      "type": "object",
      "properties": {
        "slash": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "Nets whose stored {slash} was read as the / of their label text."
        },
        "unconnected_single_pad": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "unconnected-( nets of exactly one pad whose name KiCad derives from that pad, keyed by its reference and number."
        }
      },
      "additionalProperties": false,
      "required": [
        "slash",
        "unconnected_single_pad"
      ]
    },
    "DerivedCacheCrossings": {
      "type": "object",
      "properties": {
        "rings_with_proper_crossings": {
          "type": "integer",
          "minimum": 0
        },
        "proper_edge_pair_crossings": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "rings_with_proper_crossings",
        "proper_edge_pair_crossings"
      ]
    },
    "DerivedCacheIdentityPreparation": {
      "description": "Private identity and order preparation of side b's native input copy only (c0384 2.1). By c0275's",
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "private-native-input-copy"
          ]
        },
        "side": {
          "type": "string",
          "enum": [
            "b"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "applied",
            "unneeded",
            "refused"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "label": {
          "type": "string",
          "enum": [
            "L7",
            "L7 after identity preparation",
            "L7 after order preparation",
            "L7 after identity and order preparation"
          ]
        },
        "rewritten": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "Every rewritten object: [kind, side-b identity, side-a identity]."
        },
        "moved": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            }
          },
          "description": "Every moved root segment, arc or via: [kind, side-b identity, old position, new position], positions 0-based among the root segments, arcs and vias."
        },
        "identical_pairs": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "Side-b identities of each admitted pair of fully identical pads."
        },
        "source_aliases": {
          "$ref": "#/$defs/DerivedCacheSourceAliases"
        },
        "canonical_nets": {
          "$ref": "#/$defs/DerivedCacheCanonicalNets"
        }
      },
      "additionalProperties": false,
      "required": [
        "scope",
        "side",
        "status",
        "reason",
        "label",
        "rewritten",
        "moved",
        "identical_pairs",
        "source_aliases",
        "canonical_nets"
      ]
    },
    "DerivedCacheRuleDelta": {
      "description": "Uninterpreted native JSON canonicalization; not judged rule/geometry semantics.",
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "a": {
          "$ref": "#/$defs/CanonicalNativeJson"
        },
        "b": {
          "$ref": "#/$defs/CanonicalNativeJson"
        }
      },
      "additionalProperties": false,
      "required": [
        "key",
        "a",
        "b"
      ]
    },
    "DerivedCacheSettingDelta": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "a_canonical_sha256": {
          "type": "string"
        },
        "b_canonical_sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "key",
        "a_canonical_sha256",
        "b_canonical_sha256"
      ]
    },
    "DerivedCacheSide": {
      "type": "object",
      "properties": {
        "raw_caches": {
          "type": "integer",
          "minimum": 0
        },
        "raw_non_simple_rings": {
          "$ref": "#/$defs/DerivedCacheCrossings"
        },
        "native_input_sha256": {
          "type": "string"
        },
        "qualified_caches_removed_from_private_input": {
          "type": "boolean",
          "enum": [
            true
          ]
        },
        "input_files": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exit": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "type": "string"
        },
        "stdout_sha256": {
          "type": "string"
        },
        "stderr_sha256": {
          "type": "string"
        },
        "output_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "regenerated_caches": {
          "type": "integer",
          "minimum": 0
        },
        "native_non_simple_rings": {
          "$ref": "#/$defs/DerivedCacheCrossings"
        },
        "exact_geometry_sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "raw_caches",
        "raw_non_simple_rings",
        "native_input_sha256",
        "qualified_caches_removed_from_private_input",
        "input_files",
        "command",
        "exit",
        "outcome",
        "stdout_sha256",
        "stderr_sha256",
        "output_sha256"
      ]
    },
    "DerivedCacheSides": {
      "type": "object",
      "properties": {
        "a": {
          "$ref": "#/$defs/DerivedCacheSide"
        },
        "b": {
          "$ref": "#/$defs/DerivedCacheSide"
        }
      },
      "additionalProperties": false
    },
    "DerivedCacheSourceAliases": {
      "type": "object",
      "properties": {
        "note": {
          "type": "string",
          "enum": [
            "source alias, not rewritten"
          ]
        },
        "count": {
          "type": "integer"
        },
        "identities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Side-b identities kept because their side-a identity names several objects."
        }
      },
      "additionalProperties": false,
      "required": [
        "note",
        "count",
        "identities"
      ]
    },
    "DerivedCacheSummary": {
      "description": "Existing common-tool receipt, not raw-cache equality or a DRC safety certificate.",
      "type": "object",
      "properties": {
        "judged_project_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unjudged_project_rule_deltas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DerivedCacheRuleDelta"
          }
        },
        "unjudged_project_setting_deltas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DerivedCacheSettingDelta"
          }
        },
        "whole_project_json_equality_claimed": {
          "type": "boolean",
          "enum": [
            false
          ]
        },
        "whole_native_rule_file_equality_claimed": {
          "type": "boolean",
          "enum": [
            false
          ]
        },
        "tool": {
          "type": "string",
          "enum": [
            "kicad-cli"
          ]
        },
        "version": {
          "type": "string"
        },
        "raw_cache_equality_claimed": {
          "type": "boolean",
          "enum": [
            false
          ]
        },
        "drc_safety_gate_claimed": {
          "type": "boolean",
          "enum": [
            false
          ]
        },
        "sides": {
          "$ref": "#/$defs/DerivedCacheSides"
        },
        "status": {
          "type": "string",
          "enum": [
            "equal",
            "differs",
            "native-failed",
            "native-config-changed",
            "native-cache-unqualified"
          ]
        },
        "complete_regenerated_geometry_equal": {
          "type": "boolean"
        },
        "normal_zone_priorities_normalized": {
          "type": "boolean",
          "enum": [
            false
          ]
        },
        "identity_preparation": {
          "$ref": "#/$defs/DerivedCacheIdentityPreparation"
        }
      },
      "additionalProperties": false,
      "required": [
        "judged_project_keys",
        "unjudged_project_rule_deltas",
        "unjudged_project_setting_deltas",
        "whole_project_json_equality_claimed",
        "whole_native_rule_file_equality_claimed",
        "tool",
        "version",
        "raw_cache_equality_claimed",
        "drc_safety_gate_claimed",
        "sides",
        "status"
      ]
    },
    "EmbeddedImport": {
      "description": "Earlier provenance containers preserve a sparse import member verbatim.",
      "type": "object",
      "properties": {
        "schema": {
          "type": "string"
        },
        "design": {
          "type": "string"
        },
        "licence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "copyright": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "$ref": "#/$defs/ImportSource"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InputFile"
          }
        },
        "upgrade": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Upgrade"
          }
        },
        "fenolite": {
          "type": "string"
        },
        "tools": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "date": {
          "type": "string"
        },
        "notices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "findings": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "equivalence": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImportEquivalence"
            },
            {
              "type": "null"
            }
          ]
        },
        "copy": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "schema"
      ]
    },
    "Featured": {
      "type": "object",
      "properties": {
        "permission": {
          "type": "string"
        },
        "date": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "permission"
      ]
    },
    "Fidelity": {
      "type": "object",
      "properties": {
        "accepted": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VerifySourceNewAcceptedItem"
          }
        },
        "proof": {
          "$ref": "#/$defs/FidelityProof"
        }
      },
      "additionalProperties": false
    },
    "FidelityProof": {
      "type": "object",
      "properties": {
        "derived_cache": {
          "$ref": "#/$defs/DerivedCacheSummary"
        },
        "native_project_rules": {
          "$ref": "#/$defs/NativeProjectRulesSummary"
        },
        "levels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "skipped": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "fenolite": {
          "type": "string"
        },
        "against": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "date": {
          "type": "string"
        },
        "script_sha256": {
          "type": "string"
        },
        "tolerances": {
          "$ref": "#/$defs/VerifySourceTolerances"
        },
        "generated_read_files": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "generated read-set paths mapped to SHA-256"
        }
      },
      "additionalProperties": false,
      "required": [
        "levels"
      ]
    },
    "ImportEquivalence": {
      "type": "object",
      "properties": {
        "equivalent": {
          "type": "boolean"
        },
        "levels": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "equivalent",
        "levels"
      ]
    },
    "ImportSource": {
      "type": "object",
      "properties": {
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "url",
        "revision"
      ]
    },
    "InputFile": {
      "description": "One file read: its base name, SHA-256 of its original bytes, format and format version.",
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "file",
        "sha256",
        "format"
      ]
    },
    "LicenceReview": {
      "type": "object",
      "properties": {
        "by": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "by",
        "date",
        "note"
      ]
    },
    "NativeProjectRulesSummary": {
      "description": "Scoped exact native context; unknown rule properties are explicitly outside coverage.",
      "type": "object",
      "properties": {
        "scope": {
          "type": "string"
        },
        "judged_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unjudged_absent_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "judged_count": {
          "type": "integer"
        },
        "source_major": {
          "type": "integer"
        },
        "generated_major": {
          "type": "integer"
        },
        "a_read_files": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "b_read_files": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "unjudged": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "scope",
        "judged_keys",
        "unjudged_absent_fields",
        "judged_count",
        "source_major",
        "generated_major",
        "a_read_files",
        "b_read_files",
        "unjudged"
      ]
    },
    "Trademarks": {
      "type": "object",
      "properties": {
        "marks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "restricted": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Upgrade": {
      "description": "One upgrade of a file on a private copy (decision 13).",
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "tool_version": {
          "type": "string"
        },
        "from_version": {
          "type": "integer"
        },
        "to_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256_before": {
          "type": "string"
        },
        "sha256_after": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "file",
        "tool",
        "tool_version",
        "from_version",
        "to_version",
        "sha256_before",
        "sha256_after"
      ]
    },
    "Upstream": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "archive_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "type": "string"
        },
        "retrieved": {
          "type": "string"
        },
        "spdx_expression": {
          "type": "string"
        },
        "source_location": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "url",
        "commit"
      ]
    },
    "VerifySourceNewAcceptedItem": {
      "type": "object",
      "properties": {
        "attribution": {
          "type": "string"
        },
        "decided": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "level": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ]
        },
        "reason": {
          "type": "string"
        },
        "where": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "attribution",
