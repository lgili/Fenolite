{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fenolite.import-provenance.v1",
  "title": "ImportProvenanceFile",
  "type": "object",
  "properties": {
    "schema": {
      "const": "fenolite.import-provenance.v1"
    },
    "design": {
      "type": "string"
    },
    "licence": {
      "type": "string"
    },
    "copyright": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "$ref": "#/$defs/ImportSource"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/InputFile"
      }
    },
    "upgrade": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Upgrade"
      }
    },
    "fenolite": {
      "type": "string"
    },
    "tools": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "date": {
      "type": "string"
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "equivalence": {
      "anyOf": [
        {
          "$ref": "#/$defs/ImportEquivalence"
        },
        {
          "type": "null"
        }
      ]
    },
    "copy": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema",
    "design",
    "licence",
    "copyright",
    "source",
    "inputs",
    "upgrade",
    "fenolite",
    "tools",
    "date",
    "notices",
    "findings",
    "equivalence"
  ],
  "$defs": {
    "ImportEquivalence": {
      "type": "object",
      "properties": {
        "equivalent": {
          "type": "boolean"
        },
        "levels": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "equivalent",
        "levels"
      ]
    },
    "ImportSource": {
      "type": "object",
      "properties": {
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "url",
        "revision"
      ]
    },
    "InputFile": {
      "description": "One file read: its base name, SHA-256 of its original bytes, format and format version.",
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "file",
        "sha256",
        "format"
      ]
    },
    "Upgrade": {
      "description": "One upgrade of a file on a private copy (decision 13).",
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "tool_version": {
          "type": "string"
        },
        "from_version": {
          "type": "integer"
        },
        "to_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256_before": {
          "type": "string"
        },
        "sha256_after": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "file",
        "tool",
        "tool_version",
        "from_version",
        "to_version",
        "sha256_before",
        "sha256_after"
      ]
    }
  }
}
