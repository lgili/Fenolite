{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fenolite.part.v1",
  "title": "PartFile",
  "type": "object",
  "properties": {
    "mpn": {
      "type": "string"
    },
    "extends": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "manufacturer": {
      "type": "string"
    },
    "packing": {
      "type": "string"
    },
    "lifecycle": {
      "type": "string"
    },
    "grade": {
      "type": "string"
    },
    "datasheet": {
      "type": "string"
    },
    "properties": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "ratings": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Rating"
      }
    },
    "schema": {
      "const": "fenolite.part.v1"
    },
    "id": {
      "type": "string"
    },
    "evidence": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "licence": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "sources": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      ]
    },
    "origin": {
      "anyOf": [
        {
          "$ref": "#/$defs/Origin"
        },
        {
          "$ref": "#/$defs/ImportOrigin"
        },
        {
          "$ref": "#/$defs/ProposalOrigin"
        }
      ]
    },
    "replaces": {
      "type": "string"
    },
    "deprecated": {
      "$ref": "#/$defs/Deprecation"
    },
    "reviewed_by": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Review"
      }
    },
    "waiver": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Waiver"
      }
    },
    "device": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema",
    "mpn",
    "summary",
    "id",
    "evidence",
    "device"
  ],
  "$defs": {
    "Bounds": {
      "type": "object",
      "properties": {
        "min": {
          "type": "string"
        },
        "max": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Deprecation": {
      "type": "object",
      "properties": {
        "by": {
          "type": "string"
        },
        "since": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "by",
        "since",
        "reason"
      ]
    },
    "ImportOrigin": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "shippable": {
          "type": "boolean"
        },
        "source": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OriginSource"
          }
        },
        "output": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ImportOutput"
          }
        },
        "content_sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "tool",
        "date",
        "shippable"
      ]
    },
    "ImportOutput": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "file",
        "sha256"
      ]
    },
    "Origin": {
      "description": "Where a record taken from a CC0-1.0 library came from.",
      "type": "object",
      "properties": {
        "library": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "element": {
          "type": "string"
        },
        "licence": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "library",
        "version",
        "element",
        "licence"
      ]
    },
    "OriginSource": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "member": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "file",
        "sha256"
      ]
    },
    "ProposalAuthor": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "date": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "date"
      ]
    },
    "ProposalOrigin": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "datasheet": {
          "type": "string"
        },
        "datasheet_sha256": {
          "type": "string"
        },
        "source": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OriginSource"
          }
        },
        "proposer": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProposalAuthor"
          }
        },
        "content_sha256": {
          "type": "string"
        },
        "output": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ImportOutput"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "tool",
        "date",
        "datasheet",
        "datasheet_sha256",
        "source",
        "proposer"
      ]
    },
    "Rating": {
      "type": "object",
      "properties": {
        "abs_max": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/Bounds"
            }
          ]
        },
        "operating": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/Bounds"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "Review": {
      "description": "One review of a record: who, when, of which version and digest, and the label asserted.",
      "type": "object",
      "properties": {
        "who": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "sheet": {
          "type": "string"
        },
        "sheet_sha256": {
          "type": "string"
        },
        "previous_evidence": {
          "type": "string"
        },
        "accepted_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fenolite_version": {
          "type": "string"
        },
        "record_sha256": {
          "type": "string"
        },
        "content_sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "who",
        "date",
        "version",
        "digest",
        "evidence"
      ]
    },
    "Waiver": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "reason"
      ]
    }
  }
}
