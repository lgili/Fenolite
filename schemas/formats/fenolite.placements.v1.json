{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fenolite.placements.v1",
  "title": "PlacementsFile",
  "type": "object",
  "properties": {
    "schema": {
      "const": "fenolite.placements.v1"
    },
    "part": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Placement"
      },
      "description": "Component path to pose; lengths in millimetres and angles in degrees."
    }
  },
  "additionalProperties": false,
  "required": [
    "schema"
  ],
  "$defs": {
    "Placement": {
      "type": "object",
      "properties": {
        "x": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ]
        },
        "y": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ]
        },
        "rotation": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ]
        },
        "side": {
          "enum": [
            "top",
            "bottom"
          ]
        },
        "locked": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ]
    }
  }
}
