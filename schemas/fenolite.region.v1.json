{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fenolite.result.region.v1",
  "title": "RegionResult",
  "type": "object",
  "properties": {
    "plan": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProtocolPlan"
      }
    },
    "plan_id": {
      "type": "string"
    },
    "issues_summary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProtocolIssueSummary"
      }
    },
    "recovery": {
      "$ref": "#/$defs/ProtocolRecovery"
    },
    "page": {
      "$ref": "#/$defs/ProtocolPage"
    },
    "box": {
      "$ref": "#/$defs/RegionBox"
    },
    "counts": {
      "$ref": "#/$defs/RegionCounts"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RegionItemsItem"
      }
    },
    "layer": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        }
      ]
    }
  },
  "additionalProperties": true,
  "$defs": {
    "ProtocolIssueSummary": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "count": {
          "type": "integer"
        },
        "by_severity": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "x-fenolite-map": true,
          "description": "counts indexed by severity"
        }
      },
      "additionalProperties": true,
      "required": [
        "code",
        "count",
        "by_severity"
      ]
    },
    "ProtocolPage": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "limit": {
          "type": "integer"
        },
        "offset": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        },
        "next": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true,
      "required": [
        "path",
        "limit",
        "offset",
        "total",
        "next"
      ]
    },
    "ProtocolPlan": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "bytes": {
          "type": "integer"
        },
        "sha256": {
          "type": "string"
        },
        "overwrite": {
          "type": "boolean"
        }
      },
      "additionalProperties": true,
      "required": [
        "path",
        "kind",
        "bytes",
        "sha256",
        "overwrite"
      ]
    },
    "ProtocolRecovery": {
      "type": "object",
      "properties": {
        "failed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preserved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "failed",
        "preserved"
      ]
    },
    "RegionBox": {
      "type": "object",
      "properties": {
        "x0": {
          "type": "integer"
        },
        "x1": {
          "type": "integer"
        },
        "y0": {
          "type": "integer"
        },
        "y1": {
          "type": "integer"
        }
      },
      "additionalProperties": true,
      "required": [
        "x0",
        "x1",
        "y0",
        "y1"
      ]
    },
    "RegionCounts": {
      "type": "object",
      "properties": {
        "arc": {
          "type": "integer"
        },
        "footprint": {
          "type": "integer"
        },
        "pad": {
          "type": "integer"
        },
        "text": {
          "type": "integer"
        },
        "track": {
          "type": "integer"
        },
        "via": {
          "type": "integer"
        },
        "zone": {
          "type": "integer"
        }
      },
      "additionalProperties": true,
      "required": [
        "track"
      ]
    },
    "RegionItemsItem": {
      "type": "object",
      "properties": {
        "box": {
          "$ref": "#/$defs/RegionItemsItemBox"
        },
        "kind": {
          "type": "string"
        },
        "layer": {
          "type": "string"
        },
        "net": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "where": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "box",
        "kind",
        "layer",
        "net",
        "where"
      ]
    },
    "RegionItemsItemBox": {
      "type": "object",
      "properties": {
        "x0": {
          "type": "integer"
        },
        "x1": {
          "type": "integer"
        },
        "y0": {
          "type": "integer"
        },
        "y1": {
          "type": "integer"
        }
      },
      "additionalProperties": true,
      "required": [
        "x0",
        "x1",
        "y0",
        "y1"
      ]
    }
  }
}
