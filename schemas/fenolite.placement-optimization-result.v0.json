{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fenolite.placement-optimization-result.v0",
  "title": "PlacementOptimization",
  "type": "object",
  "properties": {
    "input_sha256": {
      "type": "string"
    },
    "termination": {
      "enum": [
        "complete",
        "budget_exhausted",
        "cancelled",
        "missing_inputs"
      ]
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/OptimizationCandidate"
      }
    },
    "unplaced": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fixed": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "movable": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sampled": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "domain_truncated": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "intent": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ResolvedIntent"
      }
    },
    "score_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "work": {
      "type": "integer"
    },
    "beam_pruned": {
      "type": "boolean"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "partial": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProposedPose"
      }
    },
    "schema": {
      "enum": [
        "fenolite.placement-optimization-result.v0"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "input_sha256",
    "termination"
  ],
  "$defs": {
    "OptimizationCandidate": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "poses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProposedPose"
          }
        },
        "score": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "missing_inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "channel_overflow_by_layer": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "probes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PadProbe"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "poses",
        "score",
        "missing_inputs"
      ]
    },
    "PadIdentity": {
      "type": "object",
      "properties": {
        "footprint_id": {
          "type": "string"
        },
        "pad_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "footprint_id",
        "pad_id"
      ]
    },
    "PadProbe": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "length_nm": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "expanded": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "required": [
        "key",
        "status"
      ]
    },
    "PlacementIntent": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "endpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PadIdentity"
          }
        },
        "origin": {
          "enum": [
            "suggested",
            "confirmed",
            "declared"
          ]
        },
        "source": {
          "type": "string"
        },
        "rule_version": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "max_distance_nm": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "key",
        "kind",
        "endpoints",
        "origin",
        "source",
        "rule_version",
        "rationale"
      ]
    },
    "Point": {
      "description": "A position in nanometres.",
      "type": "object",
      "properties": {
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ]
    },
    "ProposedPose": {
      "type": "object",
      "properties": {
        "footprint_id": {
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Point"
        },
        "rotation": {
          "type": "integer"
        },
        "side": {
          "enum": [
            "top",
            "bottom"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "footprint_id",
        "position",
        "rotation",
        "side"
      ]
    },
    "ResolvedIntent": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "effective": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlacementIntent"
            },
            {
              "type": "null"
            }
          ]
        },
        "alternatives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlacementIntent"
          }
        },
        "problem": {
          "anyOf": [
            {
              "enum": [
                "conflict",
                "missing_endpoint"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "key",
        "effective",
        "alternatives"
      ]
    }
  }
}
