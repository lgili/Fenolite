{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fenolite.result.diff.v0",
  "title": "DiffResult",
  "type": "object",
  "properties": {
    "plan": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProtocolPlan"
      }
    },
    "plan_id": {
      "type": "string"
    },
    "issues_summary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProtocolIssueSummary"
      }
    },
    "recovery": {
      "$ref": "#/$defs/ProtocolRecovery"
    },
    "page": {
      "$ref": "#/$defs/ProtocolPage"
    },
    "a": {
      "$ref": "#/$defs/DiffA"
    },
    "allow": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "b": {
      "$ref": "#/$defs/DiffB"
    },
    "differences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DiffDifferencesItem"
      }
    },
    "equal": {
      "type": "boolean"
    },
    "first_difference": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        }
      ]
    },
    "heads": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/DiffHeadsValue"
      },
      "x-fenolite-map": true,
      "description": "Keys are supplied by named items, rather than fixed record fields."
    },
    "merge": {
      "$ref": "#/$defs/DiffMerge"
    },
    "resave": {
      "$ref": "#/$defs/DiffResave"
    },
    "summary": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/DiffSummaryValue"
      },
      "x-fenolite-map": true,
      "description": "Keys are supplied by named items, rather than fixed record fields."
    },
    "total": {
      "type": "integer"
    },
    "truncated": {
      "type": "boolean"
    },
    "view": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "DiffA": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "kind",
        "path"
      ]
    },
    "DiffB": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "kind",
        "path"
      ]
    },
    "DiffDifferencesItem": {
      "type": "object",
      "properties": {
        "a": {
          "type": "string"
        },
        "b": {
          "type": "string"
        },
        "change": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "a",
        "b",
        "change",
        "path"
      ]
    },
    "DiffHeadsValue": {
      "type": "object",
      "properties": {
        "a": {
          "type": "integer"
        },
        "b": {
          "type": "integer"
        }
      },
      "additionalProperties": true,
      "required": [
        "a",
        "b"
      ]
    },
    "DiffMerge": {
      "type": "object",
      "properties": {
        "already": {
          "type": "integer"
        },
        "applied": {
          "type": "integer"
        },
        "conflicts": {
          "type": "integer"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DiffMergeItemsItem"
          }
        },
        "out": {
          "type": "string"
        },
        "refused": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "theirs": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "already",
        "applied",
        "conflicts",
        "items",
        "out",
        "refused",
        "theirs"
      ]
    },
    "DiffMergeItemsItem": {
      "type": "object",
      "properties": {
        "change": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "change",
        "key",
        "status"
      ]
    },
    "DiffResave": {
      "type": "object",
      "properties": {
        "streams": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "x-fenolite-map": true,
          "description": "Keys are supplied by named items, rather than fixed record fields."
        },
        "total": {
          "type": "integer"
        }
      },
      "additionalProperties": true,
      "required": [
        "streams",
        "total"
      ]
    },
    "DiffSummaryValue": {
      "type": "object",
      "properties": {
        "added": {
          "type": "integer"
        },
        "changed": {
          "type": "integer"
        },
        "removed": {
          "type": "integer"
        }
      },
      "additionalProperties": true,
      "required": [
        "added",
        "changed",
        "removed"
      ]
    },
    "ProtocolIssueSummary": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "count": {
          "type": "integer"
        },
        "by_severity": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "x-fenolite-map": true,
          "description": "counts indexed by severity"
        }
      },
      "additionalProperties": true,
      "required": [
        "code",
        "count",
        "by_severity"
      ]
    },
    "ProtocolPage": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "limit": {
          "type": "integer"
        },
        "offset": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        },
        "next": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true,
      "required": [
        "path",
        "limit",
        "offset",
        "total",
        "next"
      ]
    },
    "ProtocolPlan": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "bytes": {
          "type": "integer"
        },
        "sha256": {
          "type": "string"
        },
        "overwrite": {
          "type": "boolean"
        }
      },
      "additionalProperties": true,
      "required": [
        "path",
        "kind",
        "bytes",
        "sha256",
        "overwrite"
      ]
    },
    "ProtocolRecovery": {
      "type": "object",
      "properties": {
        "failed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preserved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "failed",
        "preserved"
      ]
    }
  }
}
