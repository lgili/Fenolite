{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fenolite.result.sync.v1",
  "title": "SyncResult",
  "type": "object",
  "properties": {
    "plan": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProtocolPlan"
      }
    },
    "plan_id": {
      "type": "string"
    },
    "issues_summary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProtocolIssueSummary"
      }
    },
    "recovery": {
      "$ref": "#/$defs/ProtocolRecovery"
    },
    "page": {
      "$ref": "#/$defs/ProtocolPage"
    },
    "board": {
      "type": "string"
    },
    "board_only": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SyncConflictsItem"
      }
    },
    "design": {
      "type": "string"
    },
    "drawn": {
      "anyOf": [
        {
          "$ref": "#/$defs/DrawnSyncSummary"
        },
        {
          "type": "null"
        }
      ]
    },
    "edits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "orphans": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "out": {
      "type": "string"
    },
    "pending": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "placements": {
      "type": "integer"
    },
    "script_output": {
      "type": "string"
    },
    "sheets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "symbols": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "target": {
      "type": "string"
    },
    "unplaced": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "DrawnSyncSummary": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "planned": {
          "type": "boolean"
        },
        "wires": {
          "type": "integer"
        },
        "junctions": {
          "type": "integer"
        },
        "labels": {
          "type": "integer"
        },
        "buses": {
          "type": "integer"
        },
        "opaque": {
          "type": "integer"
        }
      },
      "additionalProperties": true,
      "required": [
        "file",
        "planned",
        "wires",
        "junctions",
        "labels",
        "buses",
        "opaque"
      ]
    },
    "ProtocolIssueSummary": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "count": {
          "type": "integer"
        },
        "by_severity": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "x-fenolite-map": true,
          "description": "counts indexed by severity"
        }
      },
      "additionalProperties": true,
      "required": [
        "code",
        "count",
        "by_severity"
      ]
    },
    "ProtocolPage": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "limit": {
          "type": "integer"
        },
        "offset": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        },
        "next": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true,
      "required": [
        "path",
        "limit",
        "offset",
        "total",
        "next"
      ]
    },
    "ProtocolPlan": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "bytes": {
          "type": "integer"
        },
        "sha256": {
          "type": "string"
        },
        "overwrite": {
          "type": "boolean"
        }
      },
      "additionalProperties": true,
      "required": [
        "path",
        "kind",
        "bytes",
        "sha256",
        "overwrite"
      ]
    },
    "ProtocolRecovery": {
      "type": "object",
      "properties": {
        "failed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preserved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "failed",
        "preserved"
      ]
    },
    "SyncConflictsItem": {
      "type": "object",
      "properties": {
        "base": {
          "type": "string"
        },
        "cad": {
          "$ref": "#/$defs/SyncConflictsItemCad"
        },
        "code": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "base",
        "cad",
        "code",
        "key",
        "reason"
      ]
    },
    "SyncConflictsItemCad": {
      "type": "object",
      "properties": {
        "board": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "board"
      ]
    }
  }
}
