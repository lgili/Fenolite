    "Corner": {
      "description": "A row at one corner of the rig supplies (``bench=max,aux=min``): its status and value text.",
      "type": "object",
      "properties": {
        "corner": {
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "unsure",
            "unknown",
            "deferred"
          ]
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "corner",
        "status",
        "text"
      ]
    },
    "ProtocolIssueSummary": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "count": {
          "type": "integer"
        },
        "by_severity": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "x-fenolite-map": true,
          "description": "counts indexed by severity"
        }
      },
      "additionalProperties": true,
      "required": [
        "code",
        "count",
        "by_severity"
      ]
    },
    "ProtocolPage": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "limit": {
          "type": "integer"
