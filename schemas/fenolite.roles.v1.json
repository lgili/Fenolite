    "recovery": {
      "$ref": "#/$defs/ProtocolRecovery"
    },
    "page": {
      "$ref": "#/$defs/ProtocolPage"
    },
    "classes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/RolesClassesValue"
      },
      "x-fenolite-map": true,
      "description": "Keys are supplied by named items, rather than fixed record fields."
    },
    "gates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RolesGatesItem"
      }
    },
    "kelvins": {
