{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fenolite.result.netlist.v1",
  "title": "NetlistResult",
  "type": "object",
  "properties": {
    "plan": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProtocolPlan"
      }
    },
    "plan_id": {
      "type": "string"
    },
    "issues_summary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProtocolIssueSummary"
      }
    },
    "recovery": {
      "$ref": "#/$defs/ProtocolRecovery"
    },
    "page": {
      "$ref": "#/$defs/ProtocolPage"
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NetlistComponentsItem"
      }
    },
    "counts": {
      "$ref": "#/$defs/NetlistCounts"
    },
    "nets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NetlistNetsItem"
      }
    },
    "schematic": {
      "type": "string"
    },
    "source": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "NetlistComponentsItem": {
      "type": "object",
      "properties": {
        "footprint": {
          "type": "string"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "x-fenolite-map": true,
          "description": "Keys are supplied by named items, rather than fixed record fields."
        },
        "ref": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "footprint",
        "properties",
        "ref",
        "value"
      ]
    },
    "NetlistCounts": {
      "type": "object",
      "properties": {
        "below_min_pins": {
          "type": "integer"
        },
        "components": {
          "type": "integer"
        },
        "nets": {
          "type": "integer"
        },
        "pins": {
          "type": "integer"
        },
        "unconnected": {
          "type": "integer"
        }
      },
      "additionalProperties": true,
      "required": [
        "below_min_pins",
        "components",
        "nets",
        "pins",
        "unconnected"
      ]
    },
    "NetlistNetsItem": {
      "type": "object",
      "properties": {
        "class": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "pins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NetlistNetsItemPinsItem"
          }
        },
        "unconnected": {
          "type": "boolean"
        }
      },
      "additionalProperties": true,
      "required": [
        "class",
        "name",
        "pins",
        "unconnected"
      ]
    },
    "NetlistNetsItemPinsItem": {
      "type": "object",
      "properties": {
        "pin": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "pin",
        "ref",
        "type"
      ]
    },
    "ProtocolIssueSummary": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "count": {
          "type": "integer"
        },
        "by_severity": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "x-fenolite-map": true,
          "description": "counts indexed by severity"
        }
      },
      "additionalProperties": true,
      "required": [
        "code",
        "count",
        "by_severity"
      ]
    },
    "ProtocolPage": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "limit": {
          "type": "integer"
        },
        "offset": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        },
        "next": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true,
      "required": [
        "path",
        "limit",
        "offset",
        "total",
        "next"
      ]
    },
    "ProtocolPlan": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "bytes": {
          "type": "integer"
        },
        "sha256": {
          "type": "string"
        },
        "overwrite": {
          "type": "boolean"
        }
      },
      "additionalProperties": true,
      "required": [
        "path",
        "kind",
        "bytes",
        "sha256",
        "overwrite"
      ]
    },
    "ProtocolRecovery": {
      "type": "object",
      "properties": {
        "failed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preserved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "failed",
        "preserved"
      ]
    }
  }
}
