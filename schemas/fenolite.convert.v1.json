          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "level": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "enum": [
                "S"
              ]
            }
          ]
        },
