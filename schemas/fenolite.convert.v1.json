            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConvertReportRowsItem"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "lossy",
        "refused",
        "rows"
      ]
