{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fenolite.result.convert.v1",
  "title": "ConvertResult",
  "type": "object",
  "properties": {
    "plan": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProtocolPlan"
      }
    },
    "plan_id": {
      "type": "string"
    },
    "issues_summary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProtocolIssueSummary"
      }
    },
    "recovery": {
      "$ref": "#/$defs/ProtocolRecovery"
    },
    "page": {
      "$ref": "#/$defs/ProtocolPage"
    },
    "equivalence": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/ConvertEquivalence"
        }
      ]
    },
    "experimental": {
      "type": "boolean"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ConvertFilesItem"
      }
    },
    "report": {
      "$ref": "#/$defs/ConvertReport"
    },
    "source": {
      "$ref": "#/$defs/ConvertSource"
    },
    "target": {
      "$ref": "#/$defs/ConvertTarget"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "ConvertEquivalence": {
      "type": "object",
      "properties": {
        "differences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConvertEquivalenceDifferencesItem"
          }
        },
        "equivalent": {
          "type": "boolean"
        },
        "excluded": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EquivalentExcludedItem"
          }
        },
        "explained": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConvertEquivalenceExplainedItem"
          }
        },
        "frame": {
          "type": "string"
        },
        "level": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "enum": [
                "S"
              ]
            }
          ]
        },
        "levels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConvertEquivalenceLevelsItem"
          }
        },
        "notices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EquivalentNoticesItem"
          }
        },
        "profile": {
          "$ref": "#/$defs/ConvertEquivalenceProfile"
        },
        "sides": {
          "$ref": "#/$defs/ConvertEquivalenceSides"
        },
        "tolerances": {
          "$ref": "#/$defs/ConvertEquivalenceTolerances"
        },
        "translation": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "unexplained": {
          "type": "integer"
        }
      },
      "additionalProperties": true,
      "required": [
        "differences",
        "equivalent",
        "excluded",
        "explained",
        "frame",
        "level",
        "levels",
        "notices",
        "profile",
        "sides",
        "tolerances",
        "translation",
        "unexplained"
      ]
    },
    "ConvertEquivalenceDifferencesItem": {
      "type": "object",
      "properties": {
        "a": {
          "type": "string"
        },
        "b": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "level": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "enum": [
                "S"
              ]
            }
          ]
        },
        "where": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "a",
        "b",
        "field",
        "kind",
        "level",
        "where"
      ]
    },
    "ConvertEquivalenceExplainedItem": {
      "type": "object",
      "properties": {
        "a": {
          "type": "string"
        },
        "b": {
          "type": "string"
        },
        "by": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "level": {
          "type": "integer"
        },
        "where": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "a",
        "b",
        "by",
        "field",
        "kind",
        "level",
        "where"
      ]
    },
    "ConvertEquivalenceLevelsItem": {
      "type": "object",
      "properties": {
        "compared": {
          "type": "integer"
        },
        "differences": {
          "type": "integer"
        },
        "excluded": {
          "type": "integer"
        },
        "level": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "enum": [
                "S"
              ]
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "notices": {
          "type": "integer"
        },
        "summary": {
          "$ref": "#/$defs/ConvertEquivalenceLevelsItemSummary"
        }
      },
      "additionalProperties": true,
      "required": [
        "compared",
        "differences",
        "excluded",
        "level",
        "name",
        "notices",
        "summary"
      ]
    },
    "ConvertEquivalenceLevelsItemSummary": {
      "type": "object",
      "properties": {
        "extraction_issues": {
          "type": "integer"
        },
        "instances": {
          "type": "integer"
        },
        "pins": {
          "type": "integer"
        },
        "sheets": {
          "type": "integer"
        },
        "symbols": {
          "type": "integer"
        },
        "texts": {
          "type": "integer"
        },
        "components": {
          "$ref": "#/$defs/ConvertEquivalenceLevelsItemSummaryComponents"
        },
        "copper_no_net": {
          "$ref": "#/$defs/ConvertEquivalenceLevelsItemSummaryCopperNoNet"
        },
        "copper_unknown": {
          "type": "integer"
        },
        "footprints": {
          "type": "integer"
        },
        "frame": {
          "type": "string"
        },
        "ignored": {
          "type": "integer"
        },
        "length": {
          "$ref": "#/$defs/ConvertEquivalenceLevelsItemSummaryLength"
        },
        "nets": {
          "type": "integer"
        },
        "nets_unpaired": {
          "$ref": "#/$defs/ConvertEquivalenceLevelsItemSummaryNetsUnpaired"
        },
        "pieces": {
          "$ref": "#/$defs/ConvertEquivalenceLevelsItemSummaryPieces"
        },
        "renamed": {
          "type": "integer"
        },
        "sources": {
          "$ref": "#/$defs/ConvertEquivalenceLevelsItemSummarySources"
        },
        "translation": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "unjudged": {
          "type": "integer"
        },
        "unnumbered": {
          "$ref": "#/$defs/ConvertEquivalenceLevelsItemSummaryUnnumbered"
        },
        "unshaped": {
          "$ref": "#/$defs/ConvertEquivalenceLevelsItemSummaryUnshaped"
        },
        "vias": {
          "$ref": "#/$defs/ConvertEquivalenceLevelsItemSummaryVias"
        },
        "zones_unfilled": {
          "$ref": "#/$defs/ConvertEquivalenceLevelsItemSummaryZonesUnfilled"
        }
      },
      "additionalProperties": true
    },
    "ConvertEquivalenceLevelsItemSummaryComponents": {
      "type": "object",
      "properties": {
        "a": {
          "type": "integer"
        },
        "b": {
          "type": "integer"
        }
      },
      "additionalProperties": true,
      "required": [
        "a",
        "b"
      ]
    },
    "ConvertEquivalenceLevelsItemSummaryCopperNoNet": {
      "type": "object",
      "properties": {
        "a": {
          "type": "integer"
        },
        "b": {
          "type": "integer"
        }
      },
      "additionalProperties": true,
      "required": [
        "a",
        "b"
      ]
    },
    "ConvertEquivalenceLevelsItemSummaryLength": {
      "type": "object",
      "properties": {
        "a": {
          "type": "integer"
        },
        "b": {
          "type": "integer"
        }
      },
      "additionalProperties": true,
      "required": [
        "a",
        "b"
      ]
    },
    "ConvertEquivalenceLevelsItemSummaryNetsUnpaired": {
      "type": "object",
      "properties": {
        "a": {
          "type": "integer"
        },
        "b": {
          "type": "integer"
        }
      },
      "additionalProperties": true,
      "required": [
        "a",
        "b"
      ]
    },
    "ConvertEquivalenceLevelsItemSummaryPieces": {
      "type": "object",
      "properties": {
        "a": {
          "type": "integer"
        },
        "b": {
          "type": "integer"
        }
      },
      "additionalProperties": true,
      "required": [
        "a",
        "b"
      ]
    },
    "ConvertEquivalenceLevelsItemSummarySources": {
      "type": "object",
      "properties": {
        "a": {
          "type": "string"
        },
        "b": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "a",
        "b"
      ]
    },
    "ConvertEquivalenceLevelsItemSummaryUnnumbered": {
      "type": "object",
      "properties": {
        "a": {
          "type": "integer"
