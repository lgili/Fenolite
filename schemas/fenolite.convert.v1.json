      ]
    },
    "ConvertEquivalenceLevelsItemSummaryVias": {
      "type": "object",
      "properties": {
        "a": {
          "type": "integer"
        },
        "b": {
          "type": "integer"
        }
      },
      "additionalProperties": true,
      "required": [
        "a",
        "b"
      ]
    },
    "ConvertEquivalenceLevelsItemSummaryZonesUnfilled": {
      "type": "object",
      "properties": {
        "a": {
          "type": "integer"
