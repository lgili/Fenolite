    "ConvertEquivalenceProfile": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "rules": {
          "type": "integer"
        },
        "tool_version": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "name",
        "rules",
        "tool_version"
      ]
    },
    "ConvertEquivalenceSides": {
      "type": "object",
      "properties": {
        "a": {
          "$ref": "#/$defs/ConvertEquivalenceSidesA"
        },
        "b": {
          "$ref": "#/$defs/ConvertEquivalenceSidesB"
        }
      },
      "additionalProperties": true,
      "required": [
        "a",
        "b"
      ]
    },
    "ConvertEquivalenceSidesA": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string"
        },
        "components": {
          "type": "integer"
        },
        "footprints": {
          "type": "integer"
        },
        "netlist_source": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "x-fenolite-map": true,
          "description": "exact context input basenames mapped to SHA-256"
        }
      },
      "additionalProperties": true,
      "required": [
        "backend",
        "components",
        "footprints",
        "netlist_source",
        "path",
        "sha256"
      ]
    },
    "ConvertEquivalenceSidesB": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string"
        },
        "components": {
          "type": "integer"
        },
        "footprints": {
          "type": "integer"
        },
        "netlist_source": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "x-fenolite-map": true,
          "description": "exact context input basenames mapped to SHA-256"
        }
      },
      "additionalProperties": true,
      "required": [
        "backend",
        "components",
        "footprints",
        "netlist_source",
        "path",
        "sha256"
      ]
    },
    "ConvertEquivalenceTolerances": {
      "type": "object",
      "properties": {
        "angle_udeg": {
          "type": "integer"
        },
        "length_nm": {
          "type": "integer"
        },
        "length_ppm": {
          "type": "integer"
        }
      },
      "additionalProperties": true,
      "required": [
        "angle_udeg",
        "length_nm",
        "length_ppm"
      ]
    },
    "ConvertFilesItem": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "bytes",
        "name"
      ]
    },
    "ConvertReport": {
      "type": "object",
      "properties": {
        "lossy": {
          "type": "boolean"
        },
        "refused": {
          "type": "array",
