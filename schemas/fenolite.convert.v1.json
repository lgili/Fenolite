          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "backend",
        "format_version",
        "kind",
        "path"
      ]
