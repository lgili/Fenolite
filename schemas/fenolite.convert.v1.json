    "ConvertReportRowsItem": {
      "type": "object",
      "properties": {
        "changed": {
          "type": "integer"
        },
        "group": {
          "type": "string"
        },
        "kept": {
          "type": "integer"
        },
        "kind": {
          "type": "string"
        },
        "loss": {
          "type": "string"
        },
        "lost": {
          "type": "integer"
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConvertReportRowsItemReasonsItem"
          }
        },
        "source": {
          "type": "integer"
        },
        "written": {
          "type": "integer"
        }
      },
      "additionalProperties": true,
      "required": [
        "changed",
        "group",
        "kind",
        "loss",
        "lost",
        "reasons",
        "source",
        "written"
      ]
    },
    "ConvertReportRowsItemReasonsItem": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer"
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outcome": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "count",
        "outcome",
        "reason"
      ]
